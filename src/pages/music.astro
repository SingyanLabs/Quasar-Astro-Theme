---
import Navbar from '../components/Navbar.astro';
import { SITE_CONFIG } from '../config';
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';

let rawMusicPosts = [];
try {
  rawMusicPosts = await getCollection('music');
} catch (e) {
  rawMusicPosts = [];
}

let playlist = rawMusicPosts.map((post) => {
  const fm = post.data || {};
  return {
    title: fm.title || '',
    artist: fm.artist || '',
    album: fm.album || '',
    audioUrl: fm.audioUrl || '',
    lyricUrl: fm.lyricUrl || '',
    coverUrl: fm.coverUrl || ''
  };
});

if (playlist.length === 0) {
  playlist = [
    {
      title: "Amani",
      artist: "Beyond",
      album: "Beyond 25th Anniversary",
      audioUrl: "/music/Amani-Beyond.flac",
      lyricUrl: "/music/Amani-Beyond.lrc",
      coverUrl: "/music/Amani-Beyond.webp"
    }
  ];
}
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Apple Music — {SITE_CONFIG.title}</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@500;700;900&family=Plus+Jakarta+Sans:wght@600;800&display=swap" rel="stylesheet">
    
    <ClientRouter />

    <!-- GSAP 动画引擎 -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" is:inline></script>
    
    <!-- 🎯 通过 CDN 引入 jsmediatags (无需 npm 安装任何依赖) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jsmediatags/3.9.5/jsmediatags.min.js" is:inline></script>

    <script is:inline>
      const syncTheme = () => {
        if (localStorage.getItem('theme') === 'light') {
          document.documentElement.classList.add('light-mode');
        } else {
          document.documentElement.classList.remove('light-mode');
        }
      };
      syncTheme();
      document.addEventListener('astro:after-swap', syncTheme);
    </script>
  </head>

  <body>
    <Navbar />

    <div id="playlist-data-store" data-json={JSON.stringify(playlist)} style="display: none;"></div>

    <div class="am-bg-fluid" id="am-bg"></div>
    <div class="am-bg-overlay"></div>

    <main class="apple-music-stage">
      <div class="am-grid">
        
        <!-- 左侧：唱片与控制 -->
        <div class="am-left-player">
          <div class="am-cover-box" id="cover-box">
            <img id="am-cover" src="" alt="Cover" class="am-cover-img" />
          </div>

          <div class="am-timeline-box" id="progress-container">
            <div class="am-progress-track">
              <div class="am-progress-fill" id="progress-fill"></div>
            </div>
            <div class="am-time-row">
              <span id="time-current">0:00</span>
              <span id="quality-badge" class="am-quality-badge">高解析度無損</span>
              <span id="time-remaining">-0:00</span>
            </div>
          </div>

          <div class="am-meta">
            <h1 id="am-title" class="am-song-title">曲目加载中...</h1>
            <p id="am-artist-album" class="am-song-sub">Artist — Album</p>
          </div>

          <div class="am-controls">
            <button class="am-ctrl-btn" id="btn-shuffle" title="随机播放">
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="M10.59 9.17L5.41 4L4 5.41l5.17 5.17 1.42-1.41zM14.5 4l2.04 2.04L4 18.59 5.41 20 17.96 7.45 20 9.5V4h-5.5zm.33 9.41l-1.41 1.41 3.13 3.13L14.5 20H20v-5.5l-2.04 2.04-3.13-3.13z"/></svg>
            </button>
            <button class="am-ctrl-btn" id="btn-prev" title="上一首">
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
            </button>
            <button class="am-play-main" id="btn-play" title="播放 / 暂停">
              <svg class="icon-play" viewBox="0 0 24 24"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
              <svg class="icon-pause" viewBox="0 0 24 24" style="display:none;"><path fill="currentColor" d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
            </button>
            <button class="am-ctrl-btn" id="btn-next" title="下一首">
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
            </button>
            <button class="am-ctrl-btn" id="btn-repeat" title="单曲循环">
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4z"/></svg>
            </button>
            <button class="am-ctrl-btn" id="btn-toggle-view" title="切换视图">
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z"/></svg>
            </button>
          </div>
        </div>

        <!-- 右侧视窗 -->
        <div class="am-right-viewport">
          <div class="am-view-panel active" id="panel-lyrics">
            <div class="am-lyrics-scroll-container" id="lyrics-container">
              <div class="am-lyrics-track" id="lyrics-wrapper">
                <p class="am-lyric-row">正在加载歌词引擎...</p>
              </div>
            </div>
          </div>

          <div class="am-view-panel" id="panel-queue">
            <div class="am-queue-box">
              <div class="am-queue-title">播放列表</div>
              <div class="am-queue-scroll">
                <ul class="am-song-list" id="queue-items-list"></ul>
              </div>
            </div>
          </div>
        </div>

      </div>
    </main>

    <script is:inline>
      // 📀 兜底的矢量黑胶唱片图片 (SVG Data URI)
      const DEFAULT_VINYL_COVER = `data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500"><rect width="500" height="500" fill="%23121212"/><circle cx="250" cy="250" r="220" fill="%231a1a1a"/><circle cx="250" cy="250" r="190" fill="none" stroke="%23262626" stroke-width="2"/><circle cx="250" cy="250" r="160" fill="none" stroke="%23262626" stroke-width="2"/><circle cx="250" cy="250" r="130" fill="none" stroke="%23262626" stroke-width="2"/><circle cx="250" cy="250" r="100" fill="none" stroke="%23262626" stroke-width="2"/><circle cx="250" cy="250" r="75" fill="%23d62828"/><circle cx="250" cy="250" r="25" fill="%23ffffff"/><circle cx="250" cy="250" r="8" fill="%23000000"/></svg>`;

      // 🛠 辅助：从文件名解析歌名与歌手 (如: "/music/Amani-Beyond.mp3" -> Title: Amani, Artist: Beyond)
      function parseFilename(url) {
        if (!url) return {};
        const filename = url.split('/').pop().split('?')[0].replace(/\.[^/.]+$/, "");
        const parts = filename.split('-');
        if (parts.length >= 2) {
          return { title: parts[0].trim(), artist: parts[1].trim() };
        }
        return { title: filename.trim(), artist: '' };
      }

      const initEngine = () => {
        if (window.__am_audio_instance__) {
          window.__am_audio_instance__.pause();
          window.__am_audio_instance__.currentTime = 0;
          window.__am_audio_instance__.src = '';
          window.__am_audio_instance__ = null;
        }

        const dataStore = document.getElementById('playlist-data-store');
        if (!dataStore) return;
        const playlist = JSON.parse(dataStore.dataset.json || '[]');
        if (playlist.length === 0) return;

        let currentIndex = 0;
        let isPlaying = false;
        let lyricsData = [];
        let lastActiveIndex = -1;

        const audio = new Audio();
        window.__am_audio_instance__ = audio;
        audio.volume = 0.8;

        const elBg = document.getElementById('am-bg');
        const elCover = document.getElementById('am-cover');
        const elCoverBox = document.getElementById('cover-box');
        const elTitle = document.getElementById('am-title');
        const elArtistAlbum = document.getElementById('am-artist-album');
        const elQualityBadge = document.getElementById('quality-badge');

        const elLyricsWrapper = document.getElementById('lyrics-wrapper');
        const elLyricsContainer = document.getElementById('lyrics-container');

        const elProgressFill = document.getElementById('progress-fill');
        const elProgressContainer = document.getElementById('progress-container');
        const elTimeCurrent = document.getElementById('time-current');
        const elTimeRemaining = document.getElementById('time-remaining');

        const btnPlay = document.getElementById('btn-play');
        const iconPlay = btnPlay.querySelector('.icon-play');
        const iconPause = btnPlay.querySelector('.icon-pause');
        const btnPrev = document.getElementById('btn-prev');
        const btnNext = document.getElementById('btn-next');
        const btnToggleView = document.getElementById('btn-toggle-view');

        const panelLyrics = document.getElementById('panel-lyrics');
        const panelQueue = document.getElementById('panel-queue');
        const queueList = document.getElementById('queue-items-list');

        let currentView = 'lyrics';

        btnToggleView.addEventListener('click', () => {
          if (currentView === 'lyrics') {
            currentView = 'queue';
            panelLyrics.classList.remove('active');
            panelQueue.classList.add('active');
            btnToggleView.classList.add('active');
          } else {
            currentView = 'lyrics';
            panelQueue.classList.remove('active');
            panelLyrics.classList.add('active');
            btnToggleView.classList.remove('active');
          }
        });

        const renderQueueList = () => {
          queueList.innerHTML = '';
          playlist.forEach((song, idx) => {
            const li = document.createElement('li');
            li.className = `am-song-item ${idx === currentIndex ? 'active' : ''}`;
            const displayTitle = song.displayTitle || song.title || parseFilename(song.audioUrl).title || '未知曲目';
            const displayArtist = song.displayArtist || song.artist || parseFilename(song.audioUrl).artist || '未知歌手';
            const displayCover = song.displayCover || song.coverUrl || DEFAULT_VINYL_COVER;
            
            li.innerHTML = `
              <img src="${displayCover}" class="am-s-thumb" alt="cover"/>
              <div class="am-s-info">
                <span class="am-s-title">${displayTitle}</span>
                <span class="am-s-sub">${displayArtist}</span>
              </div>
            `;
            li.addEventListener('click', () => {
              loadSong(idx);
              playAudio();
            });
            queueList.appendChild(li);
          });
        };

        async function fetchLyrics(url) {
          lyricsData = [];
          lastActiveIndex = -1;
          if (!url) {
            renderNoLyrics('純音樂');
            return;
          }
          try {
            const res = await fetch(url);
            if (!res.ok) throw new Error('Error');
            const text = await res.text();
            parseLrc(text);
          } catch (e) {
            renderNoLyrics('暫無歌詞');
          }
        }

        function parseLrc(lrcText) {
          const lines = lrcText.split('\n');
          const timeReg = /\[(\d{2}):(\d{2})\.(\d{2,3})\]/;
          lyricsData = [];
          lines.forEach(line => {
            const match = timeReg.exec(line);
            if (match) {
              const time = parseInt(match[1]) * 60 + parseInt(match[2]) + parseInt(match[3].padEnd(3, '0')) / 1000;
              const text = line.replace(timeReg, '').trim();
              if (text) lyricsData.push({ time, text });
            }
          });
          if (lyricsData.length === 0) renderNoLyrics('暫無歌詞');
          else renderLyricsDOM();
        }

        function renderNoLyrics(msg) {
          elLyricsWrapper.innerHTML = `<p class="am-lyric-row">${msg}</p>`;
          gsap.to(elLyricsWrapper.children[0], { scale: 1.4, opacity: 1, color: '#ffffff' });
        }

        function renderLyricsDOM() {
          elLyricsWrapper.innerHTML = '';
          lyricsData.forEach((item, i) => {
            const p = document.createElement('p');
            p.className = 'am-lyric-row';
            p.innerText = item.text;
            gsap.set(p, { opacity: 0, scale: 0.9, y: 20 });
            p.addEventListener('click', () => { audio.currentTime = item.time; });
            elLyricsWrapper.appendChild(p);
          });
          gsap.set(elLyricsWrapper, { y: 0 });
        }

        function updateQualityBadge(url) {
          const ext = url.split('.').pop().toLowerCase();
          const lossless = ['flac', 'wav', 'alac', 'ape'].includes(ext);
          elQualityBadge.innerText = lossless ? '高解析度無損' : `${ext.toUpperCase()} 音訊`;
          elQualityBadge.className = `am-quality-badge ${lossless ? 'lossless' : 'standard'}`;
        }

        // 🎯 关键更新：更新界面的元数据渲染
        function updateUI(t, a, alb, c) {
          elTitle.innerText = t;
          elArtistAlbum.innerText = `${a} — ${alb}`;
          elCover.src = c;
          elBg.style.backgroundImage = `url(${c})`;
        }

        function loadSong(index) {
          currentIndex = index;
          const song = playlist[currentIndex];
          const fileParsed = parseFilename(song.audioUrl);

          // 基础字段设置 (MD 优先，其次文件名，最后未知)
          let title = song.title || fileParsed.title || '未知曲目';
          let artist = song.artist || fileParsed.artist || '未知歌手';
          let album = song.album || '未知專輯';
          let cover = song.coverUrl || DEFAULT_VINYL_COVER;

          song.displayTitle = title;
          song.displayArtist = artist;
          song.displayCover = cover;

          updateUI(title, artist, album, cover);
          updateQualityBadge(song.audioUrl);
          audio.src = song.audioUrl;
          renderQueueList();
          fetchLyrics(song.lyricUrl);

          // 🎯 如果 MD 没有提供完整信息/封面，且浏览器支持 jsmediatags，从音频文件自动提取
          const needParseMeta = !song.title || !song.artist || !song.album;
          const needParseCover = !song.coverUrl;

          if ((needParseMeta || needParseCover) && window.jsmediatags && song.audioUrl) {
            window.jsmediatags.read(song.audioUrl, {
              onSuccess: function(tag) {
                const tags = tag.tags;
                
                if (needParseMeta) {
                  title = song.title || tags.title || title;
                  artist = song.artist || tags.artist || artist;
                  album = song.album || tags.album || album;
                  song.displayTitle = title;
                  song.displayArtist = artist;
                }

                if (needParseCover && tags.picture) {
                  const pic = tags.picture;
                  let base64String = "";
                  for (let i = 0; i < pic.data.length; i++) {
                    base64String += String.fromCharCode(pic.data[i]);
                  }
                  cover = `data:${pic.format};base64,${window.btoa(base64String)}`;
                  song.displayCover = cover;
                }

                updateUI(title, artist, album, cover);
                renderQueueList();
              },
              onError: function(err) {
                console.log('jsmediatags read error:', err);
              }
            });
          }
        }

        function playAudio() {
          audio.play().then(() => {
            isPlaying = true;
            iconPlay.style.display = 'none';
            iconPause.style.display = 'block';
            gsap.to(elCoverBox, { scale: 1, boxShadow: '0 25px 60px rgba(0,0,0,0.6)', duration: 0.6, ease: 'back.out(1.5)' });
          }).catch(e => console.log('Playback error:', e));
        }

        function pauseAudio() {
          audio.pause();
          isPlaying = false;
          iconPlay.style.display = 'block';
          iconPause.style.display = 'none';
          gsap.to(elCoverBox, { scale: 0.85, boxShadow: '0 10px 24px rgba(0,0,0,0.3)', duration: 0.6, ease: 'power2.out' });
        }

        btnPlay.addEventListener('click', () => isPlaying ? pauseAudio() : playAudio());
        btnPrev.addEventListener('click', () => { loadSong((currentIndex - 1 + playlist.length) % playlist.length); playAudio(); });
        btnNext.addEventListener('click', () => { loadSong((currentIndex + 1) % playlist.length); playAudio(); });

        audio.addEventListener('timeupdate', () => {
          if (!audio.duration) return;
          elProgressFill.style.width = `${(audio.currentTime / audio.duration) * 100}%`;
          elTimeCurrent.innerText = formatTime(audio.currentTime);
          elTimeRemaining.innerText = `-${formatTime(audio.duration - audio.currentTime)}`;
          runGSAPLyricsEngine();
        });

        function runGSAPLyricsEngine() {
          if (!lyricsData.length) return;
          const currentTime = audio.currentTime;
          let activeIndex = -1;

          for (let i = 0; i < lyricsData.length; i++) {
            if (currentTime >= lyricsData[i].time) activeIndex = i;
            else break;
          }

          if (activeIndex !== -1 && activeIndex !== lastActiveIndex) {
            lastActiveIndex = activeIndex;
            const lines = elLyricsWrapper.querySelectorAll('.am-lyric-row');
            
            lines.forEach((line, idx) => {
              if (idx === activeIndex) {
                gsap.to(line, { 
                  scale: 1.35, 
                  opacity: 1, 
                  color: '#ffffff', 
                  textShadow: '0 0 30px rgba(255, 255, 255, 0.7)',
                  y: 0,
                  maxWidth: '33.99rem',
                  filter: 'none',
                  duration: 0.5, 
                  ease: 'back.out(1.2)',
                  transformOrigin: 'left center',
                });
              } else if (Math.abs(idx - activeIndex) <= 2) {
                gsap.to(line, { 
                  scale: 1, 
                  opacity: 0.4, 
                  color: 'rgba(255, 255, 255, 0.5)', 
                  textShadow: 'none',
                  y: 0,
                  filter: 'blur(0.5px)',
                  duration: 0.5, 
                  ease: 'power2.out',
                  transformOrigin: 'left center'
                });
              } else {
                gsap.to(line, { 
                  scale: 0.9, 
                  opacity: 0, 
                  filter: 'blur(4px)',
                  duration: 0.5,
                  ease: 'power2.out'
                });
              }
            });

            const activeLine = lines[activeIndex];
            if (activeLine) {
              const containerH = elLyricsContainer.clientHeight;
              const targetY = activeLine.offsetTop - (containerH / 2) + (activeLine.clientHeight / 2);
              gsap.to(elLyricsWrapper, { 
                y: -Math.max(0, targetY), 
                duration: 0.8, 
                ease: "power3.out" 
              });
            }
          }
        }

        let isSeeking = false;
        elProgressContainer.addEventListener('mousedown', (e) => { isSeeking = true; seek(e); });
        window.addEventListener('mousemove', (e) => { if (isSeeking) seek(e); });
        window.addEventListener('mouseup', () => { isSeeking = false; });
        function seek(e) {
          const rect = elProgressContainer.getBoundingClientRect();
          const pct = Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width));
          if (audio.duration) audio.currentTime = pct * audio.duration;
        }

        function formatTime(secs) {
          if (isNaN(secs)) return '0:00';
          const m = Math.floor(secs / 60);
          const s = Math.floor(secs % 60);
          return `${m}:${String(s).padStart(2, '0')}`;
        }

        loadSong(0);
      };

      document.addEventListener('DOMContentLoaded', initEngine);
      document.addEventListener('astro:page-load', initEngine);
    </script>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html, body {
    background-color: #000000;
    color: #ffffff;
    font-family: 'Noto Sans SC', sans-serif;
    height: 100vh;
    overflow: hidden;
  }

  .am-bg-fluid {
    position: fixed;
    inset: -15%;
    background-size: cover;
    background-position: center;
    filter: blur(90px) brightness(0.4) saturate(1.8);
    transform: scale(1.1);
    transition: background-image 0.8s ease;
    z-index: 0;
  }

  .am-bg-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    z-index: 1;
  }

  .apple-music-stage {
    position: relative;
    z-index: 2;
    width: 100vw;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .am-grid {
    width: 100%;
    max-width: 80rem;
    height: 100vh;
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 70px;
    padding: 9.5rem 3rem !important;
  }

  .am-left-player {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
  }

  .am-cover-box {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 20px;
    overflow: hidden;
    transform: scale(0.85);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.3);
    will-change: transform, box-shadow;
  }

  .am-cover-img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
  }

  .am-timeline-box {
    width: 100%;
    cursor: pointer;
    margin-top: 8px;
  }

  .am-progress-track {
    width: 100%;
    height: 6px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
    overflow: hidden;
  }

  .am-progress-fill {
    height: 100%;
    width: 0%;
    background-color: #ffffff;
    border-radius: 3px;
  }

  .am-time-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 10px;
  }

  .am-quality-badge {
    font-size: 0.65rem;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 6px;
  }

  .am-quality-badge.lossless {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .am-quality-badge.standard {
    color: rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.08);
  }

  .am-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .am-song-title {
    font-size: 1.5rem !important;
    font-weight: 900 !important;
    color: #ffffff !important;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .am-song-sub {
    font-size: 1rem !important;
    color: rgba(255, 255, 255, 0.65) !important;
    font-weight: 500 !important;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .am-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 12px;
  }

  .am-ctrl-btn {
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.15s ease, color 0.2s ease;
  }

  .am-ctrl-btn svg { width: 22px; height: 22px; }
