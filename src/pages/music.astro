---
// src/pages/music.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import MusicBackground from '../components/music/MusicBackground.astro';
import MusicPlayerLeft from '../components/music/MusicPlayerLeft.astro';
import MusicRightPanels from '../components/music/MusicRightPanels.astro';

import '../assets/styles/music.css';
import { getCollection } from 'astro:content';

let rawMusicPosts = [];
try {
  rawMusicPosts = await getCollection('music');
} catch (e) {
  rawMusicPosts = [];
}

const playlist = rawMusicPosts.map((post) => {
  const fm = post.data || {};
  let cleanId = post.id ? post.id.replace(/\.(md|mdx)$/, '') : (post.slug || '');
  cleanId = cleanId.replace(/^music\//, '').trim();

  return {
    id: cleanId,
    title: fm.title || '',
    artist: fm.artist || '',
    album: fm.album || '',
    audioUrl: fm.audioUrl || '',
    lyricUrl: fm.lyricUrl || '',
    coverUrl: fm.coverUrl || ''
  };
});
---

<BaseLayout title="Music | Quasar">
  <!-- 引入音乐解析依赖 -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jsmediatags/3.9.5/jsmediatags.min.js" is:inline></script>
  <!-- 引入核心播放器引擎 (Vite 将自动压缩并优化它) -->
  <script>
    import '../assets/scripts/music-engine.js';
  </script>

  <!-- 将服务端数据水合到客户端 -->
  <div id="playlist-data-store" data-json={JSON.stringify(playlist)} style="display: none;"></div>

  <!-- 分布式群岛组件 -->
  <MusicBackground />

  <main class="music-stage">
    <div class="music-grid">
      <MusicPlayerLeft />
      <MusicRightPanels />
    </div>
  </main>
</BaseLayout>