---
// src/pages/posts/[...slug].astro
export const prerender = true;

import { getCollection, render } from 'astro:content';
import { SITE_CONFIG } from '../../config.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostSidebar from '../../components/posts/PostSidebar.astro';
import '../../assets/styles/post-detail.css';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);
const data = post.data || {};
const pubDate = data.pubDate ? new Date(data.pubDate).toISOString().split('T')[0] : '2026-01-01';

const recentPosts = allPosts.filter((p) => p.id !== post.id).slice(0, 5);

const hexToRgb = (hex) => {
  const num = parseInt((hex || '#015EFB').replace('#', ''), 16);
  return `${(num >> 16) & 255}, ${(num >> 8) & 255}, ${num & 255}`;
};
const themeColor = SITE_CONFIG.themeColor || '#015EFB';
const themeColorRgb = hexToRgb(themeColor);

// 🌟 提取 Markdown 的 description，降级使用 subtitle，若均无则拼接标题与站点副标题
const postDescription = data.description || data.subtitle || `${data.title}\n${SITE_CONFIG.subtitle}`;
---
<BaseLayout 
  title={`${data.title} | ${SITE_CONFIG.title}`}
  description={postDescription}
>
  <div class="post-detail-viewport" style={`--themeColor: ${themeColor}; --themeColorRgb: ${themeColorRgb};`}>
    <div class="post-detail-container">
      
      <!-- 调用抽象出来的组件侧边栏 -->
      <PostSidebar data={data} pubDate={pubDate} headings={headings} recentPosts={recentPosts} />

      <article class="main-article-content" transition:name={`card-bg-${post.id}`}>
        {data.cover && (
          <div class="article-cover">
            <img src={data.cover} alt={data.title} transition:name={`card-cover-${post.id}`} />
          </div>
        )}

        <header class="article-header">
          <h1 class="article-title" transition:name={`card-title-${post.id}`}>{data.title}</h1>
          {data.subtitle && <p class="article-subtitle">{data.subtitle}</p>}
        </header>

        <!-- Markdown 渲染 -->
        <div class="markdown-body">
          <Content />
        </div>
      </article>

    </div>
  </div>

  <script>
    import '../../assets/scripts/post-detail.js';
  </script>
</BaseLayout>
