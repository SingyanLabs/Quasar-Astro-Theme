---
// src/pages/index.astro
import { SITE_CONFIG } from '../config.ts';
import Intro from '../components/Intro.astro';
import Earth from '../components/Earth.astro';
import Navbar from '../components/Navbar.astro';
import { ClientRouter } from 'astro:transitions';

const defaultQuotes = [
  "星河璀璨，皆為序章。—— 莎士比亞",
  "保持熱愛，奔赴山海。",
  "在星空之下，傾聽時間的脈搏。"
];
const quotesList = (SITE_CONFIG as any).quotes || defaultQuotes;

const defaultGreetings = {
  morning: '早上好 ☀️',
  afternoon: '下午好 🌤️',
  evening: '晚上好 🌙',
  night: '夜深了 🌌'
};
const greetingsConfig = { ...defaultGreetings, ...((SITE_CONFIG as any).greetings || {}) };
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{SITE_CONFIG.title}</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@100;400;700;900&family=Plus+Jakarta+Sans:wght@300;700;900&display=swap" rel="stylesheet">
    
    <ClientRouter />

    <script is:inline>
      const syncSystemTheme = () => {
        if (localStorage.getItem('theme') === 'light') {
          document.documentElement.classList.add('light-mode');
        } else {
          document.documentElement.classList.remove('light-mode');
        }
      };
      syncSystemTheme();
      document.addEventListener('astro:after-swap', syncSystemTheme);
    </script>
  </head>
  <body>

    <Intro />

    <div class="main-viewport">
      
      <Navbar />

      <Earth transition:persist="earth-canvas" />

      <div class="hero-container">
        <div class="title-group">
          <h1 class="main-title anim-title-item">{SITE_CONFIG.logo}</h1>
          <p class="subtitle anim-title-item">{SITE_CONFIG.subtitle}</p>
        </div>

        <div class="right-panel-group">
          
          <!-- 天氣與預報卡片 -->
          <div class="glass-widget weather-card">
            <div class="widget-header">
              <span class="greeting-text" id="widget-greeting">你好</span>
              <span class="live-clock" id="widget-clock">00:00:00</span>
            </div>
            
            <div class="widget-divider"></div>

            <div class="widget-weather-body">
              <div class="weather-left">
                <div class="location-row">
                  <span class="location-name" id="widget-location">定位中...</span>
                  <button id="relocate-btn" class="relocate-btn" title="重新定位">
                    <svg viewBox="0 0 24 24" class="loc-icon"><path fill="currentColor" d="M12 8a4 4 0 1 0 4 4a4 4 0 0 0-4-4zm0 6a2 2 0 1 1 2-2a2 2 0 0 1-2 2zm0-12a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8a8 8 0 0 1-8 8z"/></svg>
                  </button>
                </div>
                <span class="weather-desc" id="widget-weather-desc">獲取天氣...</span>
              </div>
              <div class="temp-display" id="widget-temp">--°C</div>
            </div>

            <div class="hourly-forecast-stream" id="widget-hourly">
              <div class="hourly-pill">
                <span class="hourly-time">--:00</span>
                <div class="hourly-cond">
                  <span class="hourly-icon">🌤️</span>
                  <span class="hourly-temp">--°</span>
                </div>
              </div>
              <div class="hourly-pill-divider"></div>
              <div class="hourly-pill">
                <span class="hourly-time">--:00</span>
                <div class="hourly-cond">
                  <span class="hourly-icon">🌤️</span>
                  <span class="hourly-temp">--°</span>
                </div>
              </div>
              <div class="hourly-pill-divider"></div>
              <div class="hourly-pill">
                <span class="hourly-time">--:00</span>
                <div class="hourly-cond">
                  <span class="hourly-icon">🌤️</span>
                  <span class="hourly-temp">--°</span>
                </div>
              </div>
            </div>
          </div>

          <!-- 每日一言卡片 -->
          <div class="glass-widget quote-card">
            <div class="quote-header">
              <span class="quote-tag">DAILY QUOTE</span>
              <button id="refresh-quote-btn" class="breathing-sphere-btn" title="點擊切換">
                <span class="ring-core"></span>
                <span class="ring-outer" id="ring-outer-el"></span>
              </button>
            </div>
            <div class="quote-body">
              <p class="quote-content" id="widget-quote-text"></p>
              <div class="quote-author-wrapper">
                <span class="quote-author" id="widget-quote-author"></span>
              </div>
            </div>
          </div>

          <!-- 工作室資訊卡片 -->
          <div class="studio-card">
            <p class="studio-title">©2026 {SITE_CONFIG.copyRight}</p>
            <ul class="studio-details">
              <li><span class="red-star">*</span> {SITE_CONFIG.redStar1}</li>
              <li><span class="red-star">*</span> {SITE_CONFIG.redStar2}</li>
              <li><span class="red-star">*</span> {SITE_CONFIG.redStar3}</li>
            </ul>
          </div>

        </div>
      </div>

      <!-- 底部個人敘事區塊 -->
      <div class="footer-caption">
        <p class="bio-tagline anim-tagline-item">
          <span class="blue-dot"></span> {SITE_CONFIG.bioHeader}
        </p>
        <h2 class="bio-title" id="bio-title-el">{SITE_CONFIG.bioTitle}</h2>
        <p class="bio-desc" id="bio-desc-el">{SITE_CONFIG.bioDesc}</p>
      </div>

    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" is:inline></script>

    <script is:inline define:vars={{ quotesList, greetingsConfig }}>
      document.addEventListener('astro:page-load', () => {
        const titleItems = document.querySelectorAll('.anim-title-item');
        const taglineItem = document.querySelector('.anim-tagline-item');
        
        const weatherCard = document.querySelector('.weather-card');
        const quoteCard = document.querySelector('.quote-card');
        const studioCard = document.querySelector('.studio-card');
        
        const bioTitleEl = document.getElementById('bio-title-el');
        const bioDescEl = document.getElementById('bio-desc-el');

        // 即時時鐘與動態問候
        const updateClockAndGreeting = () => {
          const now = new Date();
          const hours = now.getHours();
          const minutes = String(now.getMinutes()).padStart(2, '0');
          const seconds = String(now.getSeconds()).padStart(2, '0');

          const clockEl = document.getElementById('widget-clock');
          const greetingEl = document.getElementById('widget-greeting');

          if (clockEl) clockEl.innerText = `${String(hours).padStart(2, '0')}:${minutes}:${seconds}`;

          if (greetingEl) {
            let greeting = '你好';
            if (hours >= 5 && hours < 12) greeting = greetingsConfig.morning;
            else if (hours >= 12 && hours < 18) greeting = greetingsConfig.afternoon;
            else if (hours >= 18 && hours < 23) greeting = greetingsConfig.evening;
            else greeting = greetingsConfig.night;
            greetingEl.innerText = greeting;
          }
        };

        updateClockAndGreeting();
        setInterval(updateClockAndGreeting, 1000);

        // 每日一言解析與切換邏輯
        const parseQuote = (item) => {
          if (!item) return { text: '', author: '' };
          if (typeof item === 'object' && item.text) {
            return { text: item.text, author: item.author || '' };
          }
          if (typeof item === 'string') {
            if (item.includes('——')) {
              const parts = item.split('——');
              return { text: parts[0].trim(), author: parts[1].trim() };
            }
            if (item.includes('|')) {
              const parts = item.split('|');
              return { text: parts[0].trim(), author: parts[1].trim() };
            }
            return { text: item.trim(), author: '' };
          }
          return { text: String(item), author: '' };
        };

        let currentQuoteIdx = 0;
        const quoteTextEl = document.getElementById('widget-quote-text');
        const quoteAuthorEl = document.getElementById('widget-quote-author');
        const refreshQuoteBtn = document.getElementById('refresh-quote-btn');
        const ringOuterEl = document.getElementById('ring-outer-el');

        const updateQuoteDisplay = (idx) => {
          const parsed = parseQuote(quotesList[idx]);
          if (quoteTextEl) quoteTextEl.innerText = parsed.text;
          if (quoteAuthorEl) {
            quoteAuthorEl.innerText = parsed.author ? `— ${parsed.author}` : '';
          }
        };

        const switchNextQuote = () => {
          if (!quotesList || quotesList.length <= 1) return;
          gsap.to([quoteTextEl, quoteAuthorEl], {
            opacity: 0,
            y: -4,
            duration: 0.2,
            onComplete: () => {
              currentQuoteIdx = (currentQuoteIdx + 1) % quotesList.length;
              updateQuoteDisplay(currentQuoteIdx);
              gsap.to([quoteTextEl, quoteAuthorEl], { opacity: 1, y: 0, duration: 0.3 });
            }
          });
        };

        updateQuoteDisplay(0);

        // 監聽呼吸圈動畫：每完成 5 次呼吸週期自動切換語錄
        let breathCount = 0;
        if (ringOuterEl) {
          ringOuterEl.addEventListener('animationiteration', () => {
            breathCount++;
            if (breathCount >= 5) {
              breathCount = 0;
              switchNextQuote();
            }
          });
        }

        if (refreshQuoteBtn && quotesList && quotesList.length > 0) {
          refreshQuoteBtn.addEventListener('click', () => {
            breathCount = 0;
            refreshQuoteBtn.classList.add('is-clicked');
            switchNextQuote();
            setTimeout(() => refreshQuoteBtn.classList.remove('is-clicked'), 400);
          });
        }

        // 天氣資料獲取與渲染
        const weatherIconMap = {
          0: { icon: '☀️', text: '晴朗' },
          1: { icon: '🌤️', text: '晴間多雲' }, 2: { icon: '⛅', text: '多雲' }, 3: { icon: '☁️', text: '陰天' },
          45: { icon: '🌫️', text: '有霧' }, 48: { icon: '🌫️', text: '濃霧' },
          51: { icon: '🌧️', text: '毛毛雨' }, 53: { icon: '🌧️', text: '小雨' }, 55: { icon: '🌧️', text: '中雨' },
          61: { icon: '🌧️', text: '小雨' }, 63: { icon: '🌧️', text: '中雨' }, 65: { icon: '🌧️', text: '大雨' },
          71: { icon: '❄️', text: '小雪' }, 73: { icon: '❄️', text: '中雪' }, 75: { icon: '❄️', text: '大雪' },
          80: { icon: '🌧️', text: '陣雨' }, 81: { icon: '🌧️', text: '強陣雨' }, 82: { icon: '⛈️', text: '暴雨' },
          95: { icon: '⛈️', text: '雷陣雨' }
        };

        const initSmartWeather = () => {
          const locationEl = document.getElementById('widget-location');
          const descEl = document.getElementById('widget-weather-desc');
          const tempEl = document.getElementById('widget-temp');
          const hourlyContainer = document.getElementById('widget-hourly');
          const relocateBtn = document.getElementById('relocate-btn');

          const fetchWeatherData = async (lat, lon, cityName = '') => {
            try {
              if (!cityName) {
                try {
                  const geoRes = await fetch(`https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=${lat}&longitude=${lon}&localityLanguage=zh`);
                  if (geoRes.ok) {
                    const geoData = await geoRes.json();
                    cityName = geoData.city || geoData.locality || geoData.principalSubdivision || '本地';
                  }
                } catch {
                  cityName = '本地';
                }
              }

              if (locationEl) locationEl.innerText = cityName;

              const weatherRes = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true&hourly=temperature_2m,weathercode&forecast_days=2`);
              if (!weatherRes.ok) throw new Error('Weather API Error');
              const weatherData = await weatherRes.json();

              const temp = Math.round(weatherData.current_weather.temperature);
              const code = weatherData.current_weather.weathercode;
              const currentWeatherInfo = weatherIconMap[code] || { icon: '🌿', text: '宜出行' };

              if (descEl) descEl.innerText = `${currentWeatherInfo.text} ${currentWeatherInfo.icon}`;
              if (tempEl) tempEl.innerText = `${temp}°C`;

              const hourlyTimes = weatherData.hourly.time;
              const hourlyTemps = weatherData.hourly.temperature_2m;
              const hourlyCodes = weatherData.hourly.weathercode;

              const nowISO = new Date();
              const currentHourStr = `${nowISO.getFullYear()}-${String(nowISO.getMonth() + 1).padStart(2, '0')}-${String(nowISO.getDate()).padStart(2, '0')}T${String(nowISO.getHours()).padStart(2, '0')}:00`;

              let currentIdx = hourlyTimes.findIndex(t => t.startsWith(currentHourStr.slice(0, 13)));
              if (currentIdx === -1) currentIdx = 0;

              if (hourlyContainer) {
                hourlyContainer.innerHTML = '';
                for (let i = 1; i <= 3; i++) {
                  const targetIdx = currentIdx + i;
                  if (targetIdx < hourlyTimes.length) {
                    const timeStr = hourlyTimes[targetIdx].slice(11, 16);
                    const hTemp = Math.round(hourlyTemps[targetIdx]);
                    const hCode = hourlyCodes[targetIdx];
                    const hInfo = weatherIconMap[hCode] || { icon: '🌤️', text: '多雲' };

                    const pill = document.createElement('div');
                    pill.className = 'hourly-pill';
                    pill.innerHTML = `
                      <span class="hourly-time">${timeStr}</span>
                      <div class="hourly-cond">
                        <span class="hourly-icon">${hInfo.icon}</span>
                        <span class="hourly-temp">${hTemp}°</span>
                      </div>
                    `;
                    hourlyContainer.appendChild(pill);

                    if (i < 3) {
                      const divider = document.createElement('div');
                      divider.className = 'hourly-pill-divider';
                      hourlyContainer.appendChild(divider);
                    }
                  }
                }
              }
            } catch (err) {
              useFallbackWeather();
            }
          };

          const useIPLocation = async () => {
            try {
              const ipRes = await fetch('https://ipwho.is/');
              if (!ipRes.ok) throw new Error('IP Fetch Failed');
              const ipData = await ipRes.json();
              if (!ipData.success) throw new Error('IP Lookup Failed');

              const city = ipData.city || ipData.region || '本地';
              await fetchWeatherData(ipData.latitude, ipData.longitude, city);
            } catch {
              useFallbackWeather();
            }
          };

          const useFallbackWeather = () => {
            if (locationEl) locationEl.innerText = '香港';
            if (descEl) descEl.innerText = '微風 🍃';
            if (tempEl) tempEl.innerText = '26°C';

            if (hourlyContainer) {
              const currentH = new Date().getHours();
              hourlyContainer.innerHTML = `
                <div class="hourly-pill">
                  <span class="hourly-time">${(currentH + 1) % 24}:00</span>
                  <div class="hourly-cond"><span class="hourly-icon">🌤️</span><span class="hourly-temp">26°</span></div>
                </div>
                <div class="hourly-pill-divider"></div>
                <div class="hourly-pill">
                  <span class="hourly-time">${(currentH + 2) % 24}:00</span>
                  <div class="hourly-cond"><span class="hourly-icon">⛅</span><span class="hourly-temp">25°</span></div>
                </div>
                <div class="hourly-pill-divider"></div>
                <div class="hourly-pill">
                  <span class="hourly-time">${(currentH + 3) % 24}:00</span>
                  <div class="hourly-cond"><span class="hourly-icon">🌙</span><span class="hourly-temp">23°</span></div>
                </div>
              `;
            }
          };

          const requestLocation = () => {
            if (locationEl) locationEl.innerText = '定位中...';
            if ('geolocation' in navigator) {
              navigator.geolocation.getCurrentPosition(
                (pos) => fetchWeatherData(pos.coords.latitude, pos.coords.longitude),
                () => useIPLocation(),
                { timeout: 6000, maximumAge: 60000, enableHighAccuracy: true }
              );
            } else {
              useIPLocation();
            }
          };

          requestLocation();

          if (relocateBtn) {
            relocateBtn.addEventListener('click', () => {
              relocateBtn.classList.add('is-spinning');
              requestLocation();
              setTimeout(() => relocateBtn.classList.remove('is-spinning'), 1000);
            });
          }
        };

        initSmartWeather();

        if (!titleItems.length) return;

        const splitTextToChars = (el) => {
          if (!el) return [];
          const rawText = el.textContent.trim();
          el.innerHTML = '';
          const charSpans = [];
          
          Array.from(rawText).forEach(char => {
            const span = document.createElement('span');
            span.className = 'char-span';
            span.textContent = char;
            el.appendChild(span);
            charSpans.push(span);
          });
          return charSpans;
        };

        const titleChars = splitTextToChars(bioTitleEl);
        const descChars = splitTextToChars(bioDescEl);

        // 頁面入場動畫序列
        const runCinematicEntrance = () => {
          gsap.killTweensOf([titleItems, taglineItem, titleChars, descChars, weatherCard, quoteCard, studioCard]);

          const tl = gsap.timeline({
            defaults: { ease: "power3.out" }
          });

          tl.fromTo(
            titleItems,
            { opacity: 0, y: 50, filter: "blur(10px)" },
            {
              opacity: 1,
              y: 0,
              filter: "blur(0px)",
              duration: 1.2,
              stagger: 0.16,
              clearProps: "transform,filter"
            }
          )
          .fromTo(
            taglineItem,
            { opacity: 0, y: 25, filter: "blur(4px)" },
            {
              opacity: 1,
              y: 0,
              filter: "blur(0px)",
              duration: 0.8,
              clearProps: "transform,filter"
            },
            "-=0.8"
          )
          .fromTo(
            titleChars,
            { opacity: 0, y: 15, filter: "blur(5px)" },
            {
              opacity: 1,
              y: 0,
              filter: "blur(0px)",
              duration: 0.45,
              stagger: 0.04,
              ease: "power2.out",
              clearProps: "transform,filter"
            },
            "-=0.5"
          )
          .fromTo(
            descChars,
            { opacity: 0, y: 12, filter: "blur(4px)" },
            {
              opacity: 1,
              y: 0,
              filter: "blur(0px)",
              duration: 0.35,
              stagger: 0.018,
              ease: "power1.out",
              clearProps: "transform,filter"
            },
            "-=0.2"
          )
          .fromTo(
            weatherCard,
            { opacity: 0, y: 35, filter: "blur(8px)" },
            {
              opacity: 1,
              y: 0,
              filter: "blur(0px)",
              duration: 0.8,
              clearProps: "transform,filter"
            },
            "-=0.4"
          )
          .fromTo(
            quoteCard,
            { opacity: 0, y: 35, filter: "blur(8px)" },
            {
              opacity: 1,
              y: 0,
              filter: "blur(0px)",
              duration: 0.8,
              clearProps: "transform,filter"
            },
            "-=0.5"
          )
          .fromTo(
            studioCard,
            { opacity: 0, y: 30, filter: "blur(6px)" },
            {
              opacity: 1,
              y: 0,
              filter: "blur(0px)",
              duration: 0.8,
              clearProps: "transform,filter"
            },
            "-=0.5"
          );
        };

        if (window._introHasPlayed) {
          runCinematicEntrance();
        } else {
          gsap.set([titleItems, taglineItem, titleChars, descChars, weatherCard, quoteCard, studioCard], { opacity: 0 });
          window.addEventListener('intro-complete', runCinematicEntrance, { once: true });
        }
      });
    </script>

  </body>
</html>

<style>

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html, body {
    background-color: #030303;
    color: #ffffff;
    font-family: 'Noto Sans SC', -apple-system, BlinkMacSystemFont, sans-serif;
    overflow: hidden;
  }

  .main-viewport {
    position: relative;
    width: 100vw;
    height: 100vh;
  }

  .hero-container {
    position: absolute;
    top: 52%;
    left: 4%;
    right: 6%;
    transform: translateY(-50%);
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 2;
    pointer-events: none;
  }

  .title-group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .main-title {
    font-weight: 900;
    font-size: 10.618rem;
    line-height: 1.25;
    letter-spacing: -0.05em;
    background: linear-gradient(180deg, #ffffff 60%, #999999 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    will-change: transform, opacity, filter;
  }

  .subtitle {
    font-weight: 200;
    font-size: 2.618rem;
    margin-top: 16px;
    letter-spacing: 0.05em;
    color: #cccccc;
    padding-left: 6px;
    will-change: transform, opacity, filter;
  }

  .right-panel-group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 330px;
    gap: 14px;
    margin-top: 30px;
  }

  .glass-widget {
    pointer-events: auto;
    width: 100%;
    padding: 22px 24px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%), rgba(16, 16, 22, 0.55);
    backdrop-filter: blur(24px) saturate(190%);
    -webkit-backdrop-filter: blur(24px) saturate(190%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 22px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
    transition: all 0.4s ease;
    will-change: transform, opacity, filter;
  }

  .glass-widget:hover {
    border-color: rgba(255, 255, 255, 0.22);
    transform: translateY(-2px);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.45);
  }

  .widget-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .greeting-text {
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.02em;
  }

  .live-clock {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--themeColor, #015EFB);
    background: rgba(255, 255, 255, 0.08);
    padding: 4px 10px;
    border-radius: 12px;
    letter-spacing: 0.05em;
  }

  .widget-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
    margin: 16px 0;
  }

  .widget-weather-body {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .weather-left {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .location-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .location-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
  }

  .relocate-btn {
    background: none;
    border: none;
