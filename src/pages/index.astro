---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Intro from '../components/Intro.astro';
import Earth from '../components/Earth.astro';
import WeatherWidget from '../components/widgets/WeatherWidget.astro';
import QuoteWidget from '../components/widgets/QuoteWidget.astro';
import StudioWidget from '../components/widgets/StudioWidget.astro';
import BioFooter from '../components/widgets/BioFooter.astro';
import { SITE_CONFIG } from '../config.ts';
import '../assets/styles/index.css'; // ⚡ 统一打包引入首页样式
---
<BaseLayout>
  <Intro />

  <div class="main-viewport">
    
    <!-- 全屏地球组件，增加外层控制容器保持持久化 -->
    <div class="earth-responsive-wrapper" transition:persist="earth-canvas">
      <Earth />
    </div>

    <div class="hero-container">
      
      <!-- 主标题区 -->
      <div class="title-group">
        <h1 class="main-title anim-title-item">{SITE_CONFIG.logo}</h1>
        <p class="subtitle anim-title-item">{SITE_CONFIG.subtitle}</p>
      </div>

      <!-- 右侧 Widget 堆叠区 -->
      <div class="right-panel-group">
        <WeatherWidget />
        <QuoteWidget />
        <StudioWidget />
      </div>

    </div>

    <!-- 底部自我介绍区 -->
    <BioFooter />

    <!-- 移动端悬浮卡片开关 (仅严格在 < 768px 时显示) -->
    <button id="mobile-widget-toggle" class="mobile-widget-toggle" title="切換掛件卡片">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="7" height="7" rx="1"></rect>
        <rect x="14" y="3" width="7" height="7" rx="1"></rect>
        <rect x="14" y="14" width="7" height="7" rx="1"></rect>
        <rect x="3" y="14" width="7" height="7" rx="1"></rect>
      </svg>
    </button>
  </div>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const titleItems = document.querySelectorAll('.anim-title-item');
    const taglineItem = document.querySelector('.anim-tagline-item');
    const weatherCard = document.querySelector('.weather-card');
    const quoteCard = document.querySelector('.quote-card');
    const studioCard = document.querySelector('.studio-card');
    const bioTitleEl = document.getElementById('bio-title-el');
    const bioDescEl = document.getElementById('bio-desc-el');

    // 移动端卡片切换交互逻辑 (严格匹配 768px)
    const mobileToggle = document.getElementById('mobile-widget-toggle');
    const rightPanel = document.querySelector('.right-panel-group');
    const titleGroup = document.querySelector('.title-group');

    if (mobileToggle && rightPanel && titleGroup) {
      mobileToggle.addEventListener('click', () => {
        mobileToggle.classList.toggle('is-active');
        rightPanel.classList.toggle('is-open');
        titleGroup.classList.toggle('is-hidden');
      });
    }

    if (!titleItems.length) return;

    // 分割字符用于逐字飞入动画
    const splitTextToChars = (el) => {
      if (!el) return [];
      const rawText = el.textContent.trim();
      el.innerHTML = '';
      const charSpans = [];
      Array.from(rawText).forEach(char => {
        const span = document.createElement('span');
        span.className = 'char-span';
        span.textContent = char;
        el.appendChild(span);
        charSpans.push(span);
      });
      return charSpans;
    };

    const titleChars = splitTextToChars(bioTitleEl);
    const descChars = splitTextToChars(bioDescEl);

    // 页面入场动画序列
    const runCinematicEntrance = () => {
      gsap.killTweensOf([titleItems, taglineItem, titleChars, descChars, weatherCard, quoteCard, studioCard]);

      const tl = gsap.timeline({ defaults: { ease: "power3.out" } });

      tl.fromTo(titleItems, { opacity: 0, y: 50, filter: "blur(10px)" }, { opacity: 1, y: 0, filter: "blur(0px)", duration: 1.2, stagger: 0.16, clearProps: "transform,filter" })
        .fromTo(taglineItem, { opacity: 0, y: 25, filter: "blur(4px)" }, { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.8, clearProps: "transform,filter" }, "-=0.8")
        .fromTo(titleChars, { opacity: 0, y: 15, filter: "blur(5px)" }, { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.45, stagger: 0.04, ease: "power2.out", clearProps: "transform,filter" }, "-=0.5")
        .fromTo(descChars, { opacity: 0, y: 12, filter: "blur(4px)" }, { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.35, stagger: 0.018, ease: "power1.out", clearProps: "transform,filter" }, "-=0.2")
        .fromTo(weatherCard, { opacity: 0, y: 35, filter: "blur(8px)" }, { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.8, clearProps: "transform,filter" }, "-=0.4")
        .fromTo(quoteCard, { opacity: 0, y: 35, filter: "blur(8px)" }, { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.8, clearProps: "transform,filter" }, "-=0.5")
        .fromTo(studioCard, { opacity: 0, y: 30, filter: "blur(6px)" }, { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.8, clearProps: "transform,filter" }, "-=0.5");
    };

    if (window._introHasPlayed) {
      runCinematicEntrance();
    } else {
      gsap.set([titleItems, taglineItem, titleChars, descChars, weatherCard, quoteCard, studioCard], { opacity: 0 });
      window.addEventListener('intro-complete', runCinematicEntrance, { once: true });
    }
  });
</script>
