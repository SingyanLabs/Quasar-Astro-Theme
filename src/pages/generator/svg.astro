---
// title: "SVG 代码编辑器"
// description: "纯浏览器端实时渲染与编辑 SVG，内置格式化、SVG 属性重构、无损代码压缩、实时节点解析与一键导出功能。"
// badge: "SVG"

import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../../config';

if (import.meta.env.PROD) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const themeColor = SITE_CONFIG.themeColor || '#015EFB';
---

<BaseLayout title="SVG 代码编辑器">
  <main class="svg-gen-viewport">
    <div class="gen-layout">
      <!-- 左侧：代码编辑面板 -->
      <aside class="editor-panel">
        <div class="panel-header">
          <a href="/generator" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            返回工具箱
          </a>
          <div class="title-row">
            <div>
              <h1 class="panel-title">SVG 代码编辑器</h1>
              <p class="panel-subtitle">编辑 SVG 代码，实时预览效果</p>
            </div>
            <!-- ⚡ 撤销 / 重做 / 黑白（支持双向切回） -->
            <div class="preset-pill-group">
              <button type="button" class="preset-btn" id="btn-undo" title="撤销 (Ctrl+Z)">撤销</button>
              <button type="button" class="preset-btn" id="btn-redo" title="重做 (Ctrl+Y)">重做</button>
              <button type="button" class="preset-btn" id="btn-bw" title="切换黑白/彩色模式">黑白</button>
            </div>
          </div>
        </div>

        <!-- 顶部功能快捷按键 -->
        <div class="action-bar">
          <button type="button" class="action-btn" id="btn-new">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="12" y1="18" x2="12" y2="12"/>
              <line x1="9" y1="15" x2="15" y2="15"/>
            </svg>
            新建 (300x200)
          </button>
          
          <label class="action-btn file-upload-label">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="17 8 12 3 7 8"/>
              <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
            上传
            <input type="file" id="input-file" accept=".svg" hidden />
          </label>

          <button type="button" class="action-btn" id="btn-format">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="21" y1="10" x2="3" y2="10"/>
              <line x1="21" y1="6" x2="3" y2="6"/>
              <line x1="21" y1="14" x2="3" y2="14"/>
              <line x1="21" y1="18" x2="3" y2="18"/>
            </svg>
            格式化
          </button>

          <button type="button" class="action-btn" id="btn-compact">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
            紧凑化
          </button>

          <button type="button" class="action-btn" id="btn-copy">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
            复制
          </button>

          <button type="button" class="action-btn" id="btn-download">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            下载
          </button>

          <button type="button" class="action-btn btn-danger" id="btn-clear">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 6h18"/>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
            </svg>
            清空
          </button>
        </div>

        <!-- SVG 文本输入框 -->
        <div class="code-editor-container">
          <textarea id="svg-input" placeholder="请输入或粘贴 SVG 代码..." spellcheck="false"></textarea>
        </div>

        <!-- 底部元数据计算栏 -->
        <div class="editor-statusbar">
          <span class="status-indicator" id="status-tag">有效</span>
          <span class="meta-item" id="meta-size">大小: 0 字节</span>
          <span class="meta-item" id="meta-elements">元素: 0</span>
          <span class="meta-item" id="meta-attrs">属性: 0</span>
        </div>
      </aside>

      <!-- 右侧：实时渲染预览舞台 -->
      <section class="preview-panel">
        <div class="preview-header">
          <div>
            <h2 class="preview-title">实时预览</h2>
            <p class="preview-subtitle">SVG 渲染预览</p>
          </div>
          <!-- 背景模式选择框 -->
          <div class="bg-selector-group">
            <span class="bg-label">背景:</span>
            <select id="bg-select" class="bg-dropdown">
              <option value="transparent">棋盘格 (透明)</option>
              <option value="#09090b" selected>极夜黑</option>
              <option value="#ffffff">纯白色</option>
              <option value="#18181b">深灰色</option>
            </select>
          </div>
        </div>

        <!-- SVG 实际渲染舞台 -->
        <div class="canvas-viewport" id="canvas-viewport">
          <div class="svg-render-container" id="svg-render-box">
            <p class="placeholder-text" id="placeholder-tip">请输入或上传 SVG 代码...</p>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script is:inline>
  function setupSvgEditor() {
    const svgInput = document.getElementById('svg-input');
    const svgRenderBox = document.getElementById('svg-render-box');
    const placeholderTip = document.getElementById('placeholder-tip');
    const bgSelect = document.getElementById('bg-select');
    const canvasViewport = document.getElementById('canvas-viewport');

    const statusTag = document.getElementById('status-tag');
    const metaSize = document.getElementById('meta-size');
    const metaElements = document.getElementById('meta-elements');
    const metaAttrs = document.getElementById('meta-attrs');

    const btnNew = document.getElementById('btn-new');
    const btnFormat = document.getElementById('btn-format');
    const btnCompact = document.getElementById('btn-compact');
    const btnCopy = document.getElementById('btn-copy');
    const btnDownload = document.getElementById('btn-download');
    const btnClear = document.getElementById('btn-clear');
    const inputFile = document.getElementById('input-file');

    const btnUndo = document.getElementById('btn-undo');
    const btnRedo = document.getElementById('btn-redo');
    const btnBw = document.getElementById('btn-bw');

    if (!svgInput || !svgRenderBox) return;

    // 默认初始模板
    const DEFAULT_SVG = `<svg width="300" height="200" viewBox="0 0 300 200" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect width="300" height="200" rx="20" fill="#0D0D11" stroke="rgba(255,255,255,0.1)"/>
  <circle cx="150" cy="100" r="60" fill="url(#grad)" opacity="0.8"/>
  <path d="M120 100L140 120L180 80" stroke="#FFFFFF" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
  <defs>
    <linearGradient id="grad" x1="90" y1="40" x2="210" y2="160" gradientUnits="userSpaceOnUse">
      <stop stop-color="#015EFB"/>
      <stop offset="1" stop-color="#8B5CF6"/>
    </linearGradient>
  </defs>
</svg>`;

    // 撤销 / 重做 历史记录栈
    let historyStack = [];
    let historyIndex = -1;
    let isInternalUpdate = false;

    // ⚡ 黑白/彩色 双向开关状态管理
    let isGrayscale = false;
    let originalColorCode = '';

    const resetBWMode = () => {
      isGrayscale = false;
      originalColorCode = '';
      if (btnBw) {
        btnBw.classList.remove('active');
        btnBw.innerText = '黑白';
      }
    };

    const pushHistory = (val) => {
      if (isInternalUpdate) return;
      if (historyStack[historyIndex] === val) return;

      historyStack = historyStack.slice(0, historyIndex + 1);
      historyStack.push(val);
      if (historyStack.length > 50) historyStack.shift();
      historyIndex = historyStack.length - 1;
      updateUndoRedoBtnState();
    };

    const updateUndoRedoBtnState = () => {
      if (btnUndo) btnUndo.style.opacity = historyIndex > 0 ? '1' : '0.4';
      if (btnRedo) btnRedo.style.opacity = historyIndex < historyStack.length - 1 ? '1' : '0.4';
    };

    // 格式化 XML/SVG
    const formatXml = (xmlStr) => {
      let formatted = '';
      let reg = /(>)(<)(\/*)/g;
      let xml = xmlStr.replace(reg, '$1\r\n$2$3');
      let pad = 0;

      xml.split('\r\n').forEach((node) => {
        let indent = 0;
        if (node.match(/.+<\/\w[^>]*>$/)) {
          indent = 0;
        } else if (node.match(/^<\/\w/)) {
          if (pad !== 0) pad -= 1;
        } else if (node.match(/^<\w[^>]*[^\/]>$/)) {
          indent = 1;
        } else {
          indent = 0;
        }

        formatted += '  '.repeat(pad) + node + '\r\n';
        pad += indent;
      });

      return formatted.trim();
    };

    // 代码紧凑化/压缩
    const compactSvg = (code) => {
      return code
        .replace(/<!--[\s\S]*?-->/g, '')
        .replace(/>\s+</g, '><')
        .replace(/\s+/g, ' ')
        .trim();
    };

    // 转换黑白灰度
    const convertToBW = (code) => {
      const parser = new DOMParser();
      const doc = parser.parseFromString(code, 'image/svg+xml');
      if (doc.querySelector('parsererror')) return code;

      const canvasCtx = document.createElement('canvas').getContext('2d');

      const colorToGrayHex = (colorStr) => {
        if (!colorStr) return colorStr;
        const trimmed = colorStr.trim();
        if (trimmed === 'none' || trimmed === 'transparent' || trimmed === 'currentColor' || trimmed.startsWith('url(')) {
          return colorStr;
        }

        canvasCtx.fillStyle = '#000000';
        canvasCtx.fillStyle = trimmed;
        const comp = canvasCtx.fillStyle;
        if (!comp || !comp.startsWith('#') || comp.length < 7) return colorStr;

        const r = parseInt(comp.slice(1, 3), 16);
        const g = parseInt(comp.slice(3, 5), 16);
        const b = parseInt(comp.slice(5, 7), 16);

        const gray = Math.round(0.299 * r + 0.587 * g + 0.114 * b);
        const hex = gray.toString(16).padStart(2, '0');
        return `#${hex}${hex}${hex}`.toUpperCase();
      };

      const processStyleString = (styleStr) => {
        if (!styleStr) return styleStr;
        return styleStr.split(';').map(item => {
          const parts = item.split(':');
          if (parts.length === 2) {
            const prop = parts[0].trim().toLowerCase();
            const val = parts[1].trim();
            if (['fill', 'stroke', 'stop-color', 'color'].includes(prop)) {
              return `${parts[0]}: ${colorToGrayHex(val)}`;
            }
          }
          return item;
        }).join(';');
      };

      const elements = doc.querySelectorAll('*');
      elements.forEach(el => {
        ['fill', 'stroke', 'stop-color', 'color'].forEach(attr => {
          if (el.hasAttribute(attr)) {
            el.setAttribute(attr, colorToGrayHex(el.getAttribute(attr)));
          }
        });

        if (el.hasAttribute('style')) {
          el.setAttribute('style', processStyleString(el.getAttribute('style')));
        }
      });

      return new XMLSerializer().serializeToString(doc.documentElement);
    };

    // 渲染与指标统计
    const updateRenderAndMeta = (recordHistory = true) => {
      const code = svgInput.value.trim();

      if (recordHistory) {
        pushHistory(svgInput.value);
      }

      if (!code) {
        svgRenderBox.innerHTML = '';
        if (placeholderTip) {
          placeholderTip.style.display = 'block';
          svgRenderBox.appendChild(placeholderTip);
        }
        statusTag.innerText = '空';
        statusTag.className = 'status-indicator status-empty';
        metaSize.innerText = '大小: 0 字节';
        metaElements.innerText = '元素: 0';
        metaAttrs.innerText = '属性: 0';
        return;
      }

      if (placeholderTip) placeholderTip.style.display = 'none';

      const byteSize = new Blob([code]).size;
      metaSize.innerText = `大小: ${byteSize < 1024 ? byteSize + ' 字节' : (byteSize / 1024).toFixed(2) + ' KB'}`;

      const parser = new DOMParser();
      const doc = parser.parseFromString(code, 'image/svg+xml');
      const parserError = doc.querySelector('parsererror');

      if (parserError) {
        statusTag.innerText = '语法错误';
        statusTag.className = 'status-indicator status-error';
        svgRenderBox.innerHTML = `<div class="render-error-box">SVG 代码解析错误，请检查语法结构。</div>`;
        metaElements.innerText = '元素: 0';
        metaAttrs.innerText = '属性: 0';
      } else {
        statusTag.innerText = '有效';
        statusTag.className = 'status-indicator status-valid';
        svgRenderBox.innerHTML = code;

        const allElements = doc.querySelectorAll('*');
        let totalAttrs = 0;
        allElements.forEach(el => totalAttrs += el.attributes.length);

        metaElements.innerText = `元素: ${allElements.length}`;
        metaAttrs.innerText = `属性: ${totalAttrs}`;
      }
    };

    // 键盘输入防抖
    let inputTimer = null;
    svgInput.oninput = () => {
      updateRenderAndMeta(false);
      clearTimeout(inputTimer);
      inputTimer = setTimeout(() => {
        pushHistory(svgInput.value);
      }, 400);
    };

    // 撤销 / 重做事件
    if (btnUndo) {
      btnUndo.onclick = () => {
        if (historyIndex > 0) {
          historyIndex--;
          isInternalUpdate = true;
          svgInput.value = historyStack[historyIndex];
          updateRenderAndMeta(false);
          updateUndoRedoBtnState();
          isInternalUpdate = false;
        }
      };
    }

    if (btnRedo) {
      btnRedo.onclick = () => {
        if (historyIndex < historyStack.length - 1) {
          historyIndex++;
          isInternalUpdate = true;
          svgInput.value = historyStack[historyIndex];
          updateRenderAndMeta(false);
          updateUndoRedoBtnState();
          isInternalUpdate = false;
        }
      };
    }

    // ⚡ 黑白 / 彩色 开关点击事件（支持还原彩色）
    if (btnBw) {
      btnBw.onclick = () => {
        if (!svgInput.value.trim()) return;

        isGrayscale = !isGrayscale;
        if (isGrayscale) {
          btnBw.classList.add('active');
          btnBw.innerText = '彩色';
          originalColorCode = svgInput.value; // 保存彩色原本
          svgInput.value = convertToBW(svgInput.value);
          updateRenderAndMeta(true);
        } else {
          btnBw.classList.remove('active');
          btnBw.innerText = '黑白';
          if (originalColorCode) {
            svgInput.value = originalColorCode; // 恢复彩色原本
            updateRenderAndMeta(true);
          }
        }
      };
    }

    if (bgSelect && canvasViewport) {
      bgSelect.onchange = (e) => {
        const val = e.target.value;
        if (val === 'transparent') {
          canvasViewport.className = 'canvas-viewport bg-checkerboard';
          canvasViewport.style.backgroundColor = '';
        } else {
          canvasViewport.className = 'canvas-viewport';
          canvasViewport.style.backgroundColor = val;
        }
      };
    }

    if (btnNew) {
      btnNew.onclick = () => {
        resetBWMode();
        svgInput.value = DEFAULT_SVG;
        updateRenderAndMeta(true);
      };
    }

    if (btnFormat) {
      btnFormat.onclick = () => {
        if (!svgInput.value.trim()) return;
        svgInput.value = formatXml(svgInput.value);
        updateRenderAndMeta(true);
      };
    }

    if (btnCompact) {
      btnCompact.onclick = () => {
        if (!svgInput.value.trim()) return;
        svgInput.value = compactSvg(svgInput.value);
        updateRenderAndMeta(true);
      };
    }

    if (btnClear) {
      btnClear.onclick = () => {
        resetBWMode();
        svgInput.value = '';
        updateRenderAndMeta(true);
      };
    }

    // ⚡ 核心修复：点击上传按钮即清空 file.value，确保选择同一文件也会强制刷新
    if (inputFile) {
      inputFile.onclick = () => {
        inputFile.value = '';
      };

      inputFile.onchange = (e) => {
        const file = e.target.files?.[0];
        if (!file) return;

        resetBWMode(); // 上传新图片时自动解除黑白锁定，还原原色

        const reader = new FileReader();
        reader.onload = (evt) => {
          svgInput.value = evt.target?.result || '';
          updateRenderAndMeta(true);
        };
        reader.readAsText(file);
      };
    }

    if (btnCopy) {
      btnCopy.onclick = () => {
        const code = svgInput.value;
        if (!code) return;

        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(code).then(showSuccess).catch(fallbackCopy);
        } else {
          fallbackCopy();
        }

        function fallbackCopy() {
          try {
            svgInput.select();
            document.execCommand('copy');
            showSuccess();
          } catch (err) {
            alert('复制失败，请手动选择全选复制');
          }
        }

        function showSuccess() {
          const originalText = btnCopy.innerHTML;
          btnCopy.innerText = '已复制！';
          setTimeout(() => { btnCopy.innerHTML = originalText; }, 2000);
        }
      };
    }

    if (btnDownload) {
      btnDownload.onclick = () => {
        const code = svgInput.value.trim();
        if (!code) return;

        const blob = new Blob([code], { type: 'image/svg+xml;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `vector-${Date.now()}.svg`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      };
    }

    svgInput.value = DEFAULT_SVG;
    updateRenderAndMeta(true);
  }

  document.addEventListener('astro:page-load', setupSvgEditor);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    setupSvgEditor();
  } else {
    document.addEventListener('DOMContentLoaded', setupSvgEditor);
  }
</script>

<style define:vars={{ themeColor }}>
  .svg-gen-viewport {
    width: 100%;
    min-height: calc(100vh - 4.5rem);
    margin-top: 4.5rem;
    padding: 1.5rem 0 3rem 0;
    display: flex;
    justify-content: center;
  }

  .gen-layout {
    width: 94%;
    max-width: 92rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }

  .editor-panel {
    background: #0d0d11;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1.25rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: #ffffff;
    box-sizing: border-box;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #a1a1aa;
    text-decoration: none;
    font-size: 0.8rem;
    margin-bottom: 0.3rem;
  }
  .back-link:hover { color: #ffffff; }
  .back-link svg { width: 0.85rem; height: 0.85rem; }

  .title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .panel-title { font-size: 1.35rem; font-weight: 800; color: #ffffff; }
  .panel-subtitle { font-size: 0.78rem; color: #a1a1aa; margin-top: 0.1rem; }

  .preset-pill-group {
    display: flex;
    gap: 0.35rem;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.2rem;
    border-radius: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .preset-btn {
    background: transparent;
    border: none;
    color: #555;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 0.35rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .preset-btn:hover { background: rgba(255, 255, 255, 0.12); }
  .preset-btn.active {
    background: var(--themeColor);
    color: #555;
  }

  .action-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .action-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #555;
    padding: 0.4rem 0.7rem;
    border-radius: 0.45rem;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: all 0.2s ease;
  }
  .action-btn svg { width: 0.82rem; height: 0.82rem; }
  .action-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: var(--themeColor);
  }
  .btn-danger:hover {
    border-color: #ef4444;
    color: #ef4444;
  }
  .file-upload-label { cursor: pointer; }

  .code-editor-container {
    flex-grow: 1;
    min-height: 22rem;
    display: flex;
  }
  #svg-input {
    width: 100%;
    height: 100%;
    min-height: 22rem;
    background: #18181b;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.75rem;
    padding: 1rem;
    color: #e4e4e7;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.82rem;
    line-height: 1.5;
    outline: none;
    resize: vertical;
    box-sizing: border-box;
  }
  #svg-input:focus {
    border-color: var(--themeColor);
  }

  .editor-statusbar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.75rem;
    color: #a1a1aa;
    padding-top: 0.2rem;
  }
  .status-indicator {
    padding: 0.15rem 0.5rem;
    border-radius: 0.3rem;
    font-size: 0.7rem;
    font-weight: 800;
