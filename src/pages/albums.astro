---
// src/pages/albums.astro
import { SITE_CONFIG, ALBUMS_CONFIG } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import AlbumsHeader from '../components/albums/AlbumsHeader.astro';
import AlbumsMasonry from '../components/albums/AlbumsMasonry.astro';
---

<BaseLayout title={`${ALBUMS_CONFIG.nav} | ${SITE_CONFIG.title}`}>
  <div class="gallery-viewport" define:vars={{ themeColor: SITE_CONFIG.themeColor }}>
    <AlbumsHeader />
    <AlbumsMasonry />
  </div>
</BaseLayout>

<script src="../assets/scripts/albums.js"></script>

<style is:global id="albums-style">
  @import "../assets/styles/albums.css";
</style>