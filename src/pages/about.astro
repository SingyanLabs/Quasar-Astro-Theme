---
// src/pages/about.astro
import { SITE_CONFIG, ABOUT_CONFIG } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import Earth from '../components/Earth.astro';

// 引入拆分后的各个二级模块组件
import StageCapabilities from '../components/about/StageCapabilities.astro';
import StageMosaic from '../components/about/StageMosaic.astro';
import StageDeepdive from '../components/about/StageDeepdive.astro';
import StageRetirement from '../components/about/StageRetirement.astro';
import StageTechStack from '../components/about/StageTechStack.astro';
import StageContact from '../components/about/StageContact.astro';
import FloatingDock from '../components/about/FloatingDock.astro';

// 引入独立抽离的 CSS 样式文件
import '../assets/css/about.css';
---

<BaseLayout title={`About | ${SITE_CONFIG.title}`}>
  <!-- 动态注入当前主题色供 CSS 变量使用，保留原设计 -->
  <style is:inline set:html={`
    :root {
      --page-theme-color: ${SITE_CONFIG.themeColor};
    }
  `} />

  <div class="earth-horizon-layer">
    <Earth transition:persist="earth-canvas" />
  </div>

  <!-- 根视口：利用 dataset 将配置项安全地传给客户端 JS，减轻服务端负担 -->
  <main 
    class="about-cinematic-viewport opacity-0" 
    id="about-viewport"
  >
    <StageCapabilities />
    <StageMosaic />
    <StageDeepdive />
    <StageRetirement />
    <StageTechStack />
    <StageContact />
    <FloatingDock />
  </main>
</BaseLayout>

<!-- 引入独立抽离的客户端动画与逻辑引擎 (利用 is:inline 或 defer 引入) -->
<script src="/src/assets/scripts/about-animations.js" type="module"></script>