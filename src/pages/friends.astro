---
// src/pages/friends.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import FriendCard from '../components/friends/FriendCard.astro';
import ExchangeCard from '../components/friends/ExchangeCard.astro';
import SiteInfoPanel from '../components/friends/SiteInfoPanel.astro';
import GentleModal from '../components/friends/GentleModal.astro';
import Toast from '../components/friends/Toast.astro';

import { FRIENDS_CONFIG, SITE_CONFIG } from '../config';
import { getCollection } from 'astro:content';
import '../assets/styles/friends.css';

const { title, subtitle, relay, exchange, siteInfoTag, siteInfo } = FRIENDS_CONFIG;
const relayTargetHref = relay.type === 'js' ? '/relay' : relay.htmlUrl;

let friendsList: any[] = [];
try {
  const friendsEntries = await getCollection('friends');
  friendsList = friendsEntries
    .map(entry => entry.data)
    .sort(() => Math.random() - 0.5);
} catch (e) {
  console.error('Failed to load friends collection:', e);
}
---

<BaseLayout 
  title={`Friends | ${SITE_CONFIG.title}`}
  description={`${subtitle}`}
>
  <div class="friends-viewport">
    <div class="friends-container">
      
      <!-- 1. Header 头部区域 -->
      <div class="friends-header">
        <h1 class="main-title">{title}</h1>
        
        <div class="subtitle-row">
          <p class="subtitle">{subtitle}</p>          
          <div class="relay-wrapper">
            <a 
              href={relayTargetHref} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="relay-badge-btn" 
              id="relay-btn"
            >
              <span class="relay-pulse-dot"></span>
              <span class="relay-text">{relay.text}</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- 2. 友链卡片网格 -->
      <div class="friends-grid">
        {friendsList.map((item) => (
          <FriendCard 
            name={item.name} 
            url={item.url} 
            avatar={item.avatar} 
            description={item.description} 
          />
        ))}
        
        <ExchangeCard 
          tag={exchange.tag} 
          title={exchange.title} 
          description={exchange.description} 
          buttonText={exchange.buttonText} 
          link={exchange.link} 
        />
      </div>

      <!-- 3. 本站信息面板 -->
      <SiteInfoPanel tag={siteInfoTag} url={siteInfo.url} avatar={siteInfo.avatar} />

    </div>
  </div>

  <!-- 4. 交互组件 -->
  <GentleModal />
  <Toast />
</BaseLayout>

<script>
  import { initFriendsPage } from '../assets/scripts/friends.js';

  document.addEventListener('astro:page-load', () => {
    initFriendsPage();
    
    // 🌟 加载完成后统一加锁触发动画，防止重复播放
    const viewport = document.querySelector('.friends-viewport');
    if (viewport) {
      requestAnimationFrame(() => {
        viewport.classList.add('is-loaded');
      });
    }
  });
</script>
