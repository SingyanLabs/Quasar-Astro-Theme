---
// src/pages/posts/index.astro
import { getCollection } from 'astro:content';
import { SITE_CONFIG, POSTS_CONFIG } from '../config.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/posts/PostCard.astro';
import '../assets/styles/posts.css';

const rawPosts = await getCollection('posts');

function parsePostDate(dateInput) {
  if (!dateInput) return new Date();
  const d = new Date(dateInput);
  return isNaN(d.getTime()) ? new Date() : d;
}

const unSortedPosts = await Promise.all(
  rawPosts.map(async (entry) => {
    const data = entry.data || {};
    const dateObj = parsePostDate(data.pubDate);
    return {
      id: entry.id,
      slug: entry.id,
      title: data.title || '',
      subtitle: data.subtitle || '',
      description: data.description || data.subtitle || '',
      pubDate: dateObj,
      formattedDate: dateObj.toISOString().split('T')[0],
      category: data.category || (Array.isArray(data.tags) && data.tags[0]) || 'Uncategorized',
      tags: Array.isArray(data.tags) ? data.tags : [],
      cover: data.cover || '',
      readTime: data.readTime || '5 min read',
    };
  })
);

const postsData = unSortedPosts.sort((a, b) => b.pubDate.getTime() - a.pubDate.getTime());
const categories = ['All', ...new Set(postsData.map(p => p.category))].filter(Boolean);

const hexToRgb = (hex) => {
  const num = parseInt((hex || '#015EFB').replace('#', ''), 16);
  return `${(num >> 16) & 255}, ${(num >> 8) & 255}, ${num & 255}`;
};
const themeColor = SITE_CONFIG.themeColor || '#015EFB';
const themeColorRgb = hexToRgb(themeColor);
---
<BaseLayout title={`${POSTS_CONFIG.nav} | ${SITE_CONFIG.title}`}>
  <!-- 通过内联 style 透传 CSS Var 給下属所有组件及外置 CSS 文件 -->
  <div class="posts-viewport" style={`--themeColor: ${themeColor}; --themeColorRgb: ${themeColorRgb};`}>
    <div class="posts-container">
      
      <header class="posts-header">
        <div class="header-intro">
          <p class="section-tagline"><span class="blue-dot"></span>{POSTS_CONFIG.tagline}</p>
          <h1 class="main-title">{POSTS_CONFIG.title}</h1>
          <p class="subtitle">{POSTS_CONFIG.subtitle}</p>
        </div>

        {categories.length > 1 && (
          <div class="category-filter-bar">
            {categories.map((cat, idx) => (
              <button class={`filter-btn ${idx === 0 ? 'active' : ''}`} data-category={cat} type="button">
                {cat}
              </button>
            ))}
          </div>
        )}
      </header>

      <div class="posts-grid" id="posts-grid">
        {postsData.map((post) => <PostCard post={post} />)}
      </div>

      {postsData.length === 0 && <div class="empty-state"><p>暫無文章發佈</p></div>}
    </div>
  </div>

  <script>
    import '../assets/scripts/posts.js';
  </script>
</BaseLayout>