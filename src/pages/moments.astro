---
// src/pages/moments.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE_CONFIG } from '../config'; // 引入配置文件路径

const allMoments = await getCollection('moments');

const getYear = (m: any) => {
  if (m.data.year) return String(m.data.year).replace(/年$/, '').trim();
  const timeStr = String(m.data.time || m.data.date || '');
  const match = timeStr.match(/(20\d{2}|\d{4})/);
  return match ? match[1] : '';
};

const getMonth = (m: any) => {
  if (m.data.month) return String(m.data.month).trim();
  const timeStr = String(m.data.time || m.data.date || '');
  const match = timeStr.match(/(\d{1,2})月/);
  if (match) return `${parseInt(match[1], 10)}月`;
  const matchDash = timeStr.match(/-\d{2}-/);
  if (matchDash) return `${parseInt(matchDash[0].replace(/-/g, ''), 10)}月`;
  return '';
};

const sortedMoments = allMoments.sort((a, b) => new Date(b.data.time || b.data.date).getTime() - new Date(a.data.time || a.data.date).getTime());

const years = Array.from(new Set(sortedMoments.map(getYear))).filter(Boolean).sort().reverse();
const months = Array.from(new Set(sortedMoments.map(getMonth))).filter(Boolean).sort((a, b) => parseInt(a) - parseInt(b));
---

<BaseLayout title={`Moments | ${SITE_CONFIG.title}`}>
  <div class="split-viewport">
    <aside class="sidebar-timeline animate-sidebar">
      <div class="timeline-header">
        <h2>Moments</h2>
        <div class="filter-selectors">
          <div class="custom-dropdown" id="year-dropdown" data-value="all">
            <button type="button" class="custom-dropdown-btn" aria-label="选择年份">
              <span class="dropdown-label">年份</span>
              <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="custom-dropdown-menu">
              <div class="custom-dropdown-item selected" data-value="all">全部年份</div>
              {years.map(y => <div class="custom-dropdown-item" data-value={y}>{y}年</div>)}
            </div>
          </div>

          <div class="custom-dropdown" id="month-dropdown" data-value="all">
            <button type="button" class="custom-dropdown-btn" aria-label="选择月份">
              <span class="dropdown-label">月份</span>
              <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="custom-dropdown-menu">
              <div class="custom-dropdown-item selected" data-value="all">全月</div>
              {months.map(m => <div class="custom-dropdown-item" data-value={m}>{m}</div>)}
            </div>
          </div>

          <button id="view-mode-btn" class="minimal-btn mobile-only" aria-label="切换视图">
            <svg class="icon-feed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
            <svg class="icon-list" style="display:none;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
          </button>
        </div>
      </div>

      <div class="timeline-list">
        {sortedMoments.map((item, index) => {
          const itemId = item.id || item.slug;
          const itemYear = getYear(item);
          const itemMonth = getMonth(item);
          const thumbUrl = item.data.thumbnail || item.data.images?.[0];
          return (
            <div 
              class={`timeline-item animate-item ${index === 0 ? 'active' : ''}`}
              data-id={itemId}
              data-title={item.data.title}
              data-year={itemYear}
              data-month={itemMonth}
              style={`animation-delay: ${index * 0.05}s`}
            >
              <div class="date-col">
                <span class="day-num">{item.data.day || '01'}</span>
                <span class="month-text">{itemMonth || '1月'}</span>
              </div>
              <div class="thumb-col">
                <img data-src={thumbUrl} alt={item.data.title} class="lazy-img" />
              </div>
              <div class="info-col">
                <div class="item-title">{item.data.title}</div>
                <div class="item-sub">{item.data.subtitle}</div>
              </div>
            </div>
          );
        })}
      </div>
    </aside>

    <main class="main-detail-area">
      <div class="detail-scroll-container">
        {sortedMoments.map((item, index) => {
          const itemId = item.id || item.slug;
          const hasInitialLikes = item.data.likes && item.data.likes.length > 0;
          return (
            <article 
              class={`detail-card ${index === 0 ? 'active' : ''}`} 
              data-detail-id={itemId}
            >
              <div class="detail-user-header animate-el">
                <div class="avatar-box">
                  {SITE_CONFIG.avatar?.src ? (
                    <img src={SITE_CONFIG.avatar.src} alt={SITE_CONFIG.author || "Avatar"} class="avatar-img" />
                  ) : (
                    <span>{SITE_CONFIG.author ? SITE_CONFIG.author.charAt(0).toUpperCase() : 'C'}</span>
                  )}
                </div>
                <div class="user-meta">
                  <h3 class="author-name">{SITE_CONFIG.author || SITE_CONFIG.logo}</h3>
                  <p class="detail-title-text">{item.data.title || SITE_CONFIG.subtitle}</p>
                </div>
              </div>

              <div class="detail-desc animate-el">{item.body}</div>

              {item.data.images && item.data.images.length > 0 && (
                <div class={`detail-media-grid count-${Math.min(item.data.images.length, 9)} animate-el`}>
                  {item.data.images.map((img: string, imgIdx: number) => (
                    <div class="media-box" data-moment-id={itemId} data-index={imgIdx}>
                      <img data-src={img} alt="" class="lazy-img" />
                    </div>
                  ))}
                </div>
              )}

              <div class="detail-time-row animate-el">
                <div class="time-location-group">
                  <span>{item.data.time}</span>
                  {item.data.location && (
                    <span class="location-tag">
                      <svg class="loc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                      {item.data.location}
                    </span>
                  )}
                </div>
                <button class="post-like-btn" data-moment-id={itemId} aria-label="点赞">
                  <span class="like-heart">♥</span>
                </button>
              </div>

              <div class="likes-section animate-el" style={!hasInitialLikes ? "display: none;" : ""}>
                <span class="likes-icon-row">♥</span>
                <div class="likes-avatars">
                  <span class="avatar-tag my-like-tag">我</span>
                  {hasInitialLikes && item.data.likes.map((u: string) => <span class="avatar-tag">{u}</span>)}
                </div>
              </div>

              {item.data.comments && item.data.comments.length > 0 && (
                <div class="comments-section animate-el">
                  {item.data.comments.map((c: any) => (
                    <div class="comment-row">
                      <div class="comment-main">
                        <span class="c-user">{c.user}:</span>
                        <span class="c-text">{c.text}</span>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </article>
          );
        })}
      </div>
    </main>
  </div>

  <script id="moments-json" type="application/json">
    {JSON.stringify(sortedMoments.map(m => ({
      id: m.id || m.slug,
      title: m.data.title,
      subtitle: m.data.subtitle || '',
      time: m.data.time,
      location: m.data.location || '',
      body: m.body || '',
      images: m.data.images || [],
      likes: m.data.likes || [],
      comments: m.data.comments || []
    })))}
  </script>
</BaseLayout>

<!-- 🔑 动态路由防丢标记 data-astro-rerun + 双重持久化逻辑 -->
<script is:inline data-astro-rerun>
  (function() {
    const DB_NAME = 'QuasarMoments';
    const DB_VERSION = 2;
    const LS_LIKES_KEY = 'quasar_moments_likes_store';
    let dbInstance = null;

    // 1. LocalStorage 同步极速存储助手 (保证切页 0ms 恢复)
    const getLocalLikes = () => {
      try {
        return JSON.parse(localStorage.getItem(LS_LIKES_KEY) || '{}');
      } catch (e) {
        return {};
      }
    };

    const setLocalLike = (momentId, isLiked) => {
      try {
        const store = getLocalLikes();
        store[momentId] = isLiked;
        localStorage.setItem(LS_LIKES_KEY, JSON.stringify(store));
      } catch (e) {
        console.error('LocalStorage 写入失败:', e);
      }
    };

    // 2. 初始化 IndexedDB (QuasarMoments)
    const getDB = () => {
      return new Promise((resolve, reject) => {
        if (dbInstance) return resolve(dbInstance);

        const request = indexedDB.open(DB_NAME, DB_VERSION);

        request.onupgradeneeded = (e) => {
          const db = e.target.result;
          if (!db.objectStoreNames.contains('likes')) {
            db.createObjectStore('likes', { keyPath: 'id' });
          }
          if (!db.objectStoreNames.contains('images')) {
            db.createObjectStore('images', { keyPath: 'url' });
          }
          if (!db.objectStoreNames.contains('moments')) {
            db.createObjectStore('moments', { keyPath: 'id' });
          }
        };

        request.onsuccess = (e) => {
          dbInstance = e.target.result;
          resolve(dbInstance);
        };

        request.onerror = (e) => {
          console.error('IndexedDB (QuasarMoments) 打开失败:', e.target.error);
          reject(e.target.error);
        };
      });
    };

    const blobToBase64 = (blob) => {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onloadend = () => resolve(reader.result);
        reader.onerror = reject;
        reader.readAsDataURL(blob);
      });
    };

    const getImageDimensions = (base64Str) => {
      return new Promise((resolve) => {
        const img = new Image();
        img.onload = () => resolve({ width: img.naturalWidth, height: img.naturalHeight });
        img.onerror = () => resolve({ width: 0, height: 0 });
        img.src = base64Str;
      });
    };

    // 3. 全量保存文案、评论、点赞人名册
    const saveMomentsTextData = async () => {
      const jsonEl = document.getElementById('moments-json');
      if (!jsonEl) return;

      try {
        const momentsList = JSON.parse(jsonEl.textContent || '[]');
        const db = await getDB();
        const tx = db.transaction('moments', 'readwrite');
        const store = tx.objectStore('moments');

        momentsList.forEach((item) => {
          store.put({
            id: item.id,
            title: item.title,
            subtitle: item.subtitle,
            time: item.time,
            location: item.location,
            body: item.body,
            images: item.images,
            likes: item.likes,
            comments: item.comments,
            updatedAt: Date.now()
          });
        });
      } catch (err) {
        console.error('保存全量数据至 IndexedDB 失败:', err);
      }
    };

    // 4. 图片 Base64 与元数据存储
    const initImageCache = async () => {
      const lazyImgs = document.querySelectorAll('img[data-src]');
      if (!lazyImgs.length) return;

      try {
        const db = await getDB();
        lazyImgs.forEach((img) => {
          const rawUrl = img.getAttribute('data-src');
          if (!rawUrl || img.getAttribute('data-idb-loaded') === 'true') return;

          const tx = db.transaction('images', 'readonly');
          const store = tx.objectStore('images');
          const req = store.get(rawUrl);

          req.onsuccess = async () => {
            if (req.result && req.result.base64) {
              img.src = req.result.base64;
              img.setAttribute('data-idb-loaded', 'true');
              if (req.result.width) img.setAttribute('data-width', req.result.width);
              if (req.result.height) img.setAttribute('data-height', req.result.height);
            } else {
              try {
                const res = await fetch(rawUrl);
                if (res.ok) {
                  const blob = await res.blob();
                  const base64Str = await blobToBase64(blob);
                  const dimensions = await getImageDimensions(base64Str);

                  const writeTx = db.transaction('images', 'readwrite');
                  writeTx.objectStore('images').put({
                    url: rawUrl,
                    base64: base64Str,
                    width: dimensions.width,
                    height: dimensions.height,
                    type: blob.type,
                    size: blob.size,
                    cachedAt: Date.now()
                  });

                  img.src = base64Str;
                  img.setAttribute('data-idb-loaded', 'true');
                } else {
                  img.src = rawUrl;
                }
              } catch (fetchErr) {
                img.src = rawUrl;
              }
            }
          };

          req.onerror = () => { img.src = rawUrl; };
        });
      } catch (err) {
        lazyImgs.forEach(img => {
          const rawUrl = img.getAttribute('data-src');
          if (rawUrl) img.src = rawUrl;
        });
      }
    };

    // 5. 更新 UI 状态
    const updateMomentLikeUI = (cardEl, isLiked) => {
      if (!cardEl) return;
      const btn = cardEl.querySelector('.post-like-btn');
      const likesSection = cardEl.querySelector('.likes-section');
      const myLikeTag = cardEl.querySelector('.my-like-tag');

      if (btn) btn.classList.toggle('liked', isLiked);

      if (myLikeTag) {
        if (isLiked) {
          myLikeTag.classList.add('active');
        } else {
          myLikeTag.classList.remove('active');
        }
      }

      if (likesSection) {
        const otherTags = cardEl.querySelectorAll('.likes-avatars .avatar-tag:not(.my-like-tag)');
        if (isLiked || otherTags.length > 0) {
          likesSection.style.display = 'flex';
        } else {
          likesSection.style.display = 'none';
        }
      }
    };

    // 🔑 6. 零延迟恢复点赞状态（双轨机制：LocalStorage + IndexedDB）
    const restoreLikesUI = async () => {
      // 轨道一：立即同步读取 LocalStorage (0 毫秒完成)
      const localStore = getLocalLikes();
      const cards = document.querySelectorAll('article[data-detail-id]');
      cards.forEach(card => {
        const momentId = card.getAttribute('data-detail-id');
        if (momentId && typeof localStore[momentId] === 'boolean') {
          updateMomentLikeUI(card, localStore[momentId]);
        }
      });

      // 轨道二：异步同步 IndexedDB 校验与对齐
      try {
        const db = await getDB();
        const tx = db.transaction('likes', 'readonly');
        const store = tx.objectStore('likes');
        const req = store.getAll();

        req.onsuccess = () => {
          const records = req.result || [];
          records.forEach(record => {
            if (record.id.startsWith('post_')) {
              const momentId = record.id.replace('post_', '');
              const card = document.querySelector(`article[data-detail-id="${momentId}"]`);
              if (card && typeof record.liked === 'boolean') {
                updateMomentLikeUI(card, record.liked);
                setLocalLike(momentId, record.liked); // 同步回 LocalStorage
              }
            }
          });
        };
      } catch (e) {
        console.error('IndexedDB 点赞状态恢复异常:', e);
      }
    };

    // 7. 黄金比例点赞动画
    const playCardCenterHeartAnimation = (cardEl) => {
      if (!cardEl) return;

      const oldAnimation = cardEl.querySelector('.qm-heart-anim-overlay');
      if (oldAnimation) oldAnimation.remove();

      const overlay = document.createElement('div');
      overlay.className = 'qm-heart-anim-overlay';

      overlay.innerHTML = `
        <div class="qm-anim-glow"></div>
        <div class="qm-anim-ring"></div>
        <div class="qm-anim-dots">
          <span class="dot d1"></span>
          <span class="dot d2"></span>
          <span class="dot d3"></span>
          <span class="dot d4"></span>
          <span class="dot d5"></span>
          <span class="dot d6"></span>
          <span class="dot d7"></span>
          <span class="dot d8"></span>
        </div>
        <svg viewBox="0 0 24 24" class="qm-anim-heart">
          <defs>
            <linearGradient id="qmGradGolden" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#ff6b81" />
              <stop offset="100%" stop-color="#ff4757" />
            </linearGradient>
          </defs>
          <path fill="url(#qmGradGolden)" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
      `;

      cardEl.appendChild(overlay);

      setTimeout(() => {
        if (overlay && overlay.parentNode) {
          overlay.parentNode.removeChild(overlay);
        }
      }, 850);
    };

    // 8. 全局事件委托
    if (!window.__quasarMomentsDelegated) {
      document.addEventListener('click', async (e) => {
        const postBtn = e.target.closest('.post-like-btn');
        if (!postBtn) return;

        e.preventDefault();
        e.stopPropagation();

        const card = postBtn.closest('article[data-detail-id]');
        const momentId = postBtn.getAttribute('data-moment-id') || (card ? card.getAttribute('data-detail-id') : null);
        if (!momentId) return;

        const isCurrentlyLiked = postBtn.classList.contains('liked');
        const newLikedState = !isCurrentlyLiked;

        // UI 状态即时响应
        updateMomentLikeUI(card, newLikedState);

        // 黄金动画
        if (newLikedState && card) {
          playCardCenterHeartAnimation(card);
        }

        // 双轨持久化写入
        setLocalLike(momentId, newLikedState);

        try {
          const db = await getDB();
          const tx = db.transaction('likes', 'readwrite');
          tx.objectStore('likes').put({ id: `post_${momentId}`, liked: newLikedState, updatedAt: Date.now() });
        } catch (dbErr) {
          console.error('IndexedDB 点赞保存失败:', dbErr);
        }
      }, true);

      window.__quasarMomentsDelegated = true;
    }

    // 9. 完整生命周期挂载
    const bootstrapQuasarMoments = () => {
      restoreLikesUI();      // 零延迟同步与恢复点赞
      saveMomentsTextData(); // 保存文本/评论数据
      initImageCache();     // 图像 Base64 缓存与提取
    };

    // 多重生命周期保底：包含 BFCache 与 View Transitions
    bootstrapQuasarMoments();
    document.addEventListener('DOMContentLoaded', bootstrapQuasarMoments);
    document.addEventListener('astro:page-load', bootstrapQuasarMoments);
    window.addEventListener('pageshow', bootstrapQuasarMoments);
  })();
</script>

<script src="../assets/scripts/moments.js"></script>

<style is:global id="moments-style">
  @import "../assets/css/moments.css";

  article.detail-card {
    position: relative !important;
  }

  /* 心形按钮样式 */
  .post-like-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.45);
    transition: transform 0.18s cubic-bezier(0.175, 0.885, 0.32, 1.275), color 0.2s ease;
    user-select: none;
  }

  .post-like-btn:active {
    transform: scale(1.35);
  }

  .post-like-btn.liked, .post-like-btn.liked .like-heart {
    color: #ff4757 !important;
  }

  /* 『我』专属高亮点赞标签：弹簧气泡展开，顺滑向后推移朋友 */
  .avatar-tag.my-like-tag {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    max-width: 0;
    opacity: 0;
    transform: scale(0.3) translateX(-10px);
    margin-right: 0;
    padding: 0;
    border: 0px solid rgba(255, 71, 87, 0.35);
    overflow: hidden;
    white-space: nowrap;
    pointer-events: none;
    vertical-align: middle;
    background: rgba(255, 71, 87, 0.18) !important;
    color: #ff4757 !important;
    font-weight: 700;
    border-radius: 12px;
    transition: max-width 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
                opacity 0.25s ease,
                transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
                margin-right 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
                padding 0.35s ease,
                border-width 0.2s ease;
  }

  .avatar-tag.my-like-tag.active {
    max-width: 42px;
    opacity: 1;
    transform: scale(1) translateX(0);
    margin-right: 6px;
    padding: 2px 8px;
    border-width: 1px;
  }

  /* 黄金比例 240px 画板基座 */
  .qm-heart-anim-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 240px;
    height: 240px;
    margin-top: -120px;
    margin-left: -120px;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    user-select: none;
    z-index: 99;
  }

  /* 黄金柔光背板 */
  .qm-anim-glow {
    position: absolute;
    width: 116px;
    height: 116px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 71, 87, 0.28) 0%, rgba(255, 107, 129, 0.08) 61.8%, transparent 100%);
    animation: qmGoldenAura 0.85s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* 极细黄金微弧环 (1.2px) */
  .qm-anim-ring {
    position: absolute;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    border: 1.2px solid rgba(255, 71, 87, 0.85);
    animation: qmGoldenRing 0.8s cubic-bezier(0.1, 0.8, 0.3, 1) forwards;
  }

  /* 散落 8 颗斐波那契微粒 */
  .qm-anim-dots {
    position: absolute;
    width: 100%;
    height: 100%;
  }

  .qm-anim-dots .dot {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 4.5px;
    height: 4.5px;
    margin-top: -2.25px;
    margin-left: -2.25px;
    border-radius: 50%;
    animation: qmGoldenDot 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .dot.d1 { --angle: 0deg;   background: #ff4757; }
  .dot.d2 { --angle: 45deg;  background: #ff6b81; }
  .dot.d3 { --angle: 90deg;  background: #ffa502; }
  .dot.d4 { --angle: 135deg; background: #ff4757; }
