---
// src/layouts/BaseLayout.astro
import { SITE_CONFIG } from '../config.ts';
import ThemePerfInit from '../components/head/ThemePerfInit.astro';
import ThemeSync from '../components/head/ThemeSync.astro';
import Navbar from '../components/Navbar.astro';
import LazyLoad from '../components/common/LazyLoad.astro';
import Lightbox from '../components/common/Lightbox.astro';
import ExternalLinkGuard from '../components/common/ExternalLinkGuard.astro';
import { ClientRouter } from 'astro:transitions';

import.meta.glob('../assets/styles/*.css', { eager: true });

interface Props {
  title?: string;
  description?: string;
}

const defaultDescription = `${SITE_CONFIG.bioHeader || ''} · ${SITE_CONFIG.bioTitle || ''} · ${SITE_CONFIG.bioDesc || ''}`;

const { 
  title = SITE_CONFIG.title,
  description = Astro.props.description || defaultDescription
} = Astro.props;

const pureDescription = String(description)
  .replace(/<[^>]+>/g, '')         
  .replace(/[\r\n\t]+/g, '· ')      
  .replace(/"/g, '&quot;')         
  .replace(/\s+/g, ' ')            
  .trim();
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <ThemeSync />
    <ThemePerfInit />

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <meta name="description" content={pureDescription} />
    
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@100;400;700;900&family=Noto+Serif+SC:wght@400;700;900&family=Plus+Jakarta+Sans:wght@300;700;900&display=swap" rel="stylesheet">
    
    <!-- Astro ClientRouter 原生路由控制器 -->
    <ClientRouter />
    <!-- 挂载 ClientRouter 全生命周期 FOUC 拦截守护脚本 -->
    <script src="../utils/astroRouterGuard.js"></script>

    <script>
      import { gsap } from 'gsap';
      import { Draggable } from 'gsap/Draggable';

      gsap.registerPlugin(Draggable);

      window.gsap = gsap;
      window.Draggable = Draggable;
    </script>

  </head>
  <body>
    <Navbar />
    
    <main>
      <slot />
    </main>

    <LazyLoad />
    <Lightbox />
    <ExternalLinkGuard />
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { background-color: #030303; color: #ffffff; font-family: 'Noto Sans SC', -apple-system, BlinkMacSystemFont, sans-serif; overflow-x: hidden; }
  html.light-mode body { background-color: #f5f5f7 !important; color: #1d1d1f !important; }

  [class*="glass"], [class*="bento"], .liquid-glass-bg, .quasar-navbar, .mobile-drawer {
    isolation: auto !important;
  }

  .about-cinematic-viewport {
    transform: none !important;
    will-change: auto !important;
  }

  .unified-glass-card,
  .pillar-glass-block,
  .bento-card,
  .bento-mid-row-inner,
  .mosaic-drag-card,
  .tech-twin-card,
  .social-glass-card,
  .wechat-reward-card,
  .dock-blur-bg,
  .dock-popover-menu {
    will-change: auto !important;
    -webkit-backface-visibility: visible !important;
    backface-visibility: visible !important;
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    backdrop-filter: blur(20px) saturate(180%);
  }

  .glass-widget {
    pointer-events: auto;
    width: 100%;
    padding: 22px 24px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%), rgba(16, 16, 22, 0.55);
    -webkit-backdrop-filter: blur(24px) saturate(190%);
    backdrop-filter: blur(24px) saturate(190%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 22px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
    transition: all 0.4s ease;
  }
  .glass-widget:hover { border-color: rgba(255, 255, 255, 0.22); transform: translateY(-2px); box-shadow: 0 20px 48px rgba(0, 0, 0, 0.45); }
  html.light-mode .glass-widget { background: rgba(255, 255, 255, 0.72) !important; border-color: rgba(0, 0, 0, 0.08) !important; box-shadow: 0 12px 32px rgba(0, 0, 0, 0.06) !important; }

  .note-item {
    contain: layout paint;
    content-visibility: auto;
    contain-intrinsic-size: 0 80px;
  }

  html {
    touch-action: manipulation;
    -webkit-text-size-adjust: 100%;
  }

  body {
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  @supports (-moz-appearance: none) {
    html {
      -moz-osx-font-smoothing: grayscale;
    }

    .liquid-glass-bg,
    .glass-widget {
      will-change: transform;
      transform: translateZ(0);
    }

    .note-item {
      will-change: auto !important;
    }
  }

@supports (selector(::-webkit-scrollbar)) {
  ::-webkit-scrollbar {
    width: 3px !important;
    height: 3px !important;
  }

  ::-webkit-scrollbar-track {
    background: transparent !important;
  }

  ::-webkit-scrollbar-thumb {
    background-color: transparent;
    border-radius: 99px;
    transition: background-color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  html.is-scrolling ::-webkit-scrollbar-thumb,
  body.is-scrolling ::-webkit-scrollbar-thumb,
  *:hover::-webkit-scrollbar-thumb {
    background-color: rgba(255, 255, 255, 0.28);
  }

  ::-webkit-scrollbar-thumb:hover {
    background-color: rgba(255, 255, 255, 0.65) !important;
  }

  ::-webkit-scrollbar-thumb:active {
    background-color: rgba(255, 255, 255, 0.9) !important;
  }

  ::-webkit-scrollbar-corner {
    background: transparent !important;
  }

  html.light-mode.is-scrolling ::-webkit-scrollbar-thumb,
  html.light-mode body.is-scrolling ::-webkit-scrollbar-thumb,
  html.light-mode *:hover::-webkit-scrollbar-thumb {
    background-color: rgba(0, 0, 0, 0.22);
  }

  html.light-mode ::-webkit-scrollbar-thumb:hover {
    background-color: rgba(0, 0, 0, 0.55) !important;
  }
}

@supports not (selector(::-webkit-scrollbar)) {
  * {
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.25) transparent;
  }

  html.light-mode * {
    scrollbar-color: rgba(0, 0, 0, 0.25) transparent;
  }
}
</style>

<script is:inline>
(function() {
    let scrollTimer = null;
    let isTicking = false;

    const handleScrollState = () => {
      if (!isTicking) {
        isTicking = true;
        requestAnimationFrame(() => {
          if (!document.documentElement.classList.contains('is-scrolling')) {
            document.documentElement.classList.add('is-scrolling');
            document.body.classList.add('is-scrolling');
          }
          isTicking = false;
        });
      }

      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(() => {
        requestAnimationFrame(() => {
          document.documentElement.classList.remove('is-scrolling');
          document.body.classList.remove('is-scrolling');
        });
      }, 150);
    };

    window.addEventListener('scroll', handleScrollState, { passive: true });
  })();
</script>

