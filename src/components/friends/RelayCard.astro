---
interface Props {
  pageTitle?: string;
  pageSubtitle?: string;
  targetUrl: string;
}

const { pageTitle = '正在跳转至下一个星系...', pageSubtitle = '随机前往志同道合的技术与创作者小窝', targetUrl } = Astro.props;
---

<div class="relay-card">
  <!-- 动态微光视觉 -->
  <div class="relay-visual">
    <div class="core-glow"></div>
    <div class="orbit-ring ring-1"></div>
    <div class="orbit-ring ring-2"></div>
  </div>

  <!-- 文案面板 -->
  <div class="relay-info">
    <span class="relay-tag">// RELAY TRANSITING</span>
    <h1 class="relay-title">{pageTitle}</h1>
    <p class="relay-subtitle">{pageSubtitle}</p>
  </div>

  <!-- 高速进度条 -->
  <div class="progress-track">
    <div class="progress-fill"></div>
  </div>

  <!-- 备用链接 -->
  <a href={targetUrl} class="subtle-fallback" id="manual-fallback-link">
    若未自动跳转，点击此处直接前往 &rarr;
  </a>
</div>

<style>
  .relay-card {
    position: relative;
    width: 100%;
    max-width: 440px;
    background: rgba(16, 16, 20, 0.75);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 28px;
    padding: 3rem 2.2rem 2.5rem 2.2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
  }
  .relay-visual {
    position: relative;
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 2rem;
  }
  .core-glow {
    position: absolute;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--themeColor, #015EFB);
    box-shadow: 0 0 35px 12px rgba(var(--themeColorRgb, 1, 94, 251), 0.6);
    animation: corePulse 1.2s ease-in-out infinite;
  }
  .orbit-ring { position: absolute; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.1); }
  .ring-1 { width: 50px; height: 50px; border-top-color: var(--themeColor, #015EFB); animation: spin 1s linear infinite; }
  .ring-2 { width: 78px; height: 78px; border-bottom-color: rgba(var(--themeColorRgb, 1, 94, 251), 0.4); animation: spinReverse 1.5s linear infinite; }
  @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
  @keyframes spinReverse { 0% { transform: rotate(360deg); } 100% { transform: rotate(0deg); } }
  @keyframes corePulse { 0%, 100% { transform: scale(1); opacity: 0.8; } 50% { transform: scale(1.3); opacity: 1; } }

  .relay-info { display: flex; flex-direction: column; align-items: center; gap: 8px; margin-bottom: 2rem; }
  .relay-tag { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 0.72rem; color: #6e6e73; letter-spacing: 0.1em; font-weight: 700; }
  .relay-title {
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    background: linear-gradient(180deg, #ffffff 60%, #a1a1a6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin: 0;
  }
  .relay-subtitle { font-size: 0.88rem; color: #86868b; line-height: 1.5; margin: 0; }
  .progress-track { width: 100%; height: 3px; background: rgba(255, 255, 255, 0.06); border-radius: 4px; overflow: hidden; margin-bottom: 1.5rem; }
  .progress-fill {
    width: 0%; height: 100%; background: var(--themeColor, #015EFB);
    box-shadow: 0 0 10px var(--themeColor, #015EFB);
    border-radius: 4px; animation: fillProgress 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes fillProgress { 0% { width: 0%; } 100% { width: 100%; } }
  .subtle-fallback { font-size: 0.75rem; color: #6e6e73; text-decoration: none; transition: color 0.2s ease; }
  .subtle-fallback:hover { color: var(--themeColor, #015EFB); }

  /* ☀️ 明亮模式柔和阴影适配 */
  :global(html.light-mode) .relay-card {
    background: rgba(255, 255, 255, 0.92);
    border-color: rgba(0, 0, 0, 0.06);
    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.04), 0 20px 40px -10px rgba(0, 0, 0, 0.06);
  }
  :global(html.light-mode) .relay-title {
    background: linear-gradient(180deg, #1d1d1f 60%, #6e6e73 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  :global(html.light-mode) .relay-subtitle { color: #6e6e73; }
  :global(html.light-mode) .orbit-ring { border-color: rgba(0, 0, 0, 0.08); }
</style>