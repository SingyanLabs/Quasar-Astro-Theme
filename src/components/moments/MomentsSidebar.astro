---
// src/components/moments/MomentsSidebar.astro
interface MomentItem {
  id: string;
  title: string;
  subtitle: string;
  day: string;
  month: string;
  year: string;
  thumbnail: string;
}

interface Props {
  moments: MomentItem[];
  availableYears: string[];
  availableMonths: { label: string; value: string }[];
}

const { moments, availableYears, availableMonths } = Astro.props;
---

<aside class="sidebar-timeline animate-sidebar">
  <div class="timeline-header animate-header">
    <h2>Moments</h2>
    
    <div class="filter-selectors">
      <!-- 移动端专属：视图切换按钮（桌面端隐藏） -->
      <button id="view-mode-btn" class="minimal-btn mobile-only" type="button" aria-label="切换视图模式" title="切换模式">
        <svg class="icon-list" viewBox="0 0 24 24"><path fill="currentColor" d="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z"/></svg>
        <svg class="icon-feed" viewBox="0 0 24 24" style="display: none;"><path fill="currentColor" d="M19 5v14H5V5h14m0-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 9c-1.65 0-3-1.35-3-3s1.35-3 3-3 3 1.35 3 3-1.35 3-3 3zm0-4c-.55 0-1 .45-1 1s.45 1 1 1 1-.45 1-1-.45-1-1-1zm6 10H6v-1.5c0-2 4-3.1 6-3.1s6 1.1 6 3.1V18z"/></svg>
      </button>

      <select id="year-select" class="minimal-select" aria-label="选择年份">
        <option value="all">全部年份</option>
        {availableYears.map(y => (
          <option value={y}>{y}年</option>
        ))}
      </select>

      <select id="month-select" class="minimal-select" aria-label="选择月份">
        {availableMonths.map(m => (
          <option value={m.value}>{m.label}</option>
        ))}
      </select>
    </div>
  </div>

  <div class="timeline-list" id="timeline-list">
    {moments.map((item, index) => (
      <div 
        class={`timeline-item animate-item ${index === 0 ? 'active' : ''}`}
        style={`animation-delay: ${index * 0.04}s`}
        data-id={item.id}
        data-title={item.title}  
        data-year={item.year}
        data-month={item.month}
      >
        <div class="date-col">
          <span class="day-num">{item.day}</span>
          <span class="month-text">{item.month}</span>
        </div>
        <div class="thumb-col">
          <img src={item.thumbnail} alt={item.title} loading="lazy" />
        </div>
        <div class="info-col">
          <h3 class="item-title">{item.title}</h3>
          <p class="item-sub">{item.subtitle}</p>
        </div>
      </div>
    ))}
  </div>
</aside>