---
// src/components/Intro.astro
import IntroWord from './intro/IntroWord.astro';
---

<div id="intro-container">
  <IntroWord />
</div>

<!-- DOM 渲染瞬间同步执行：已播放过或性能降级时立即隐藏 -->
<script is:inline>
  if (window._introHasPlayed || document.documentElement.classList.contains('perf-degraded')) {
    const introEl = document.getElementById('intro-container');
    if (introEl) introEl.style.display = 'none';
  }
</script>

<script>
  import { initIntroEngine } from '../assets/scripts/intro-engine.js';
  initIntroEngine();
</script>

<style>
  #intro-container {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    background-color: #030303; 
    z-index: 9999;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  :global(html.light-mode) #intro-container {
    background-color: #030303 !important;
  }
</style>