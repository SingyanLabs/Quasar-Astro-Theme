---
<!-- 🌟 a11y 修复：添加 inert 属性，确保 aria-hidden="true" 时包含的按钮/链接不可聚焦 -->
<div class="search-modal-overlay" id="search-modal-overlay" aria-hidden="true" inert>
  <div class="search-modal-backdrop" id="search-modal-backdrop"></div>
  <div class="search-modal-container" role="dialog" aria-modal="true" aria-label="搜索结果">
    <div class="modal-search-header">
      <div class="modal-title-group">
        <svg viewBox="0 0 24 24" fill="none" class="modal-search-icon">
          <path d="M21 21L15 15M17 10C17 13.866 13.866 17 10 17C6.13401 17 3 13.866 3 10C3 6.13401 6.13401 3 10 3C13.866 3 17 6.13401 17 10Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="modal-query-label" id="modal-query-label">全文检索结果</span>
      </div>
      <!-- 🌟 a11y 修复：为关闭按钮补齐 aria-label 无障碍说明 -->
      <button class="modal-close-chip" id="modal-close-chip" type="button" aria-label="关闭搜索结果">ESC</button>
    </div>

    <div class="modal-results-body">
      <ul class="modal-results-list" id="modal-results-list">
        <li class="modal-empty-state">输入关键词开始搜索...</li>
      </ul>
    </div>

    <div class="modal-footer-hints">
      <div class="hint-item"><kbd>↑</kbd> <kbd>↓</kbd> <span>导航</span></div>
      <div class="hint-item"><kbd>↵</kbd> <span>跳转</span></div>
      <div class="hint-item"><kbd>ESC</kbd> <span>关闭</span></div>
    </div>
  </div>
</div>

<style>
  /* 🌟 a11y 修复：增加了 visibility: hidden 防防御性控制，关闭状态下绝不占用焦点树 */
  .search-modal-overlay { position: fixed; inset: 0; z-index: 90; display: flex; align-items: flex-start; justify-content: center; padding-top: 5.375rem; opacity: 0; pointer-events: none; visibility: hidden; transition: opacity 0.22s ease, visibility 0.22s ease; }
  .search-modal-overlay.active { opacity: 1; pointer-events: auto; visibility: visible; }
  .search-modal-backdrop { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.45); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
  .search-modal-container { position: relative; width: 90vw; max-width: 38.75rem; background: rgba(22, 22, 30, 0.95); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 1.125rem; box-shadow: 0 24px 80px rgba(0, 0, 0, 0.7); overflow: hidden; display: flex; flex-direction: column; z-index: 2; }
  .modal-search-header { display: flex; align-items: center; justify-content: space-between; padding: 0.875rem 1.125rem; border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
  .modal-title-group { display: flex; align-items: center; gap: 0.625rem; }
  .modal-search-icon { width: 1.0625rem; height: 1.0625rem; color: var(--themeColor, #015EFB); }
  .modal-query-label { font-size: 0.88rem; font-weight: 700; color: #ffffff; }
  .modal-close-chip { background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.12); color: rgba(255, 255, 255, 0.5); font-size: 0.68rem; font-weight: 700; padding: 2px 7px; border-radius: 5px; cursor: pointer; transition: background 0.15s ease, color 0.15s ease; }
  .modal-close-chip:hover { background: rgba(255, 255, 255, 0.15); color: #ffffff; }
  .modal-results-body { max-height: 23.75rem; overflow-y: auto; padding: 0.625rem; }
  .modal-results-body::-webkit-scrollbar { width: 5px; }
  .modal-results-body::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.18); border-radius: 3px; }
  .modal-results-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.375rem; }
  
  /* 注入的 HTML 的全局防御性样式 */
  :global(.modal-empty-state) { padding: 2rem 1.25rem; text-align: center; font-size: 0.85rem; color: rgba(255, 255, 255, 0.4); list-style: none; }
  :global(.modal-result-item) { border-radius: 0.75rem; transition: background 0.18s ease; list-style: none; }
  :global(.modal-result-item.selected), :global(.modal-result-item:hover) { background: rgba(255, 255, 255, 0.08); }
  :global(.result-card-link) { display: flex; flex-direction: column; gap: 0.375rem; padding: 0.75rem 0.875rem; text-decoration: none !important; color: inherit; }
  :global(.result-card-header) { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
  :global(.result-card-title) { font-size: 0.92rem; font-weight: 700; color: #ffffff !important; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-decoration: none !important; }
  :global(.modal-result-item.selected .result-card-title), :global(.modal-result-item:hover .result-card-title) { color: var(--themeColor, #015EFB) !important; }
  :global(.result-card-badge) { font-size: 0.68rem; font-weight: 800; padding: 2px 7px; border-radius: 5px; flex-shrink: 0; }
  :global(.badge-文章) { color: #60a5fa !important; background: rgba(96, 165, 250, 0.15) !important; border: 1px solid rgba(96, 165, 250, 0.25) !important; }
  :global(.badge-时刻) { color: #34d399 !important; background: rgba(52, 211, 153, 0.15) !important; border: 1px solid rgba(52, 211, 153, 0.25) !important; }
  :global(.badge-音乐) { color: #f472b6 !important; background: rgba(244, 114, 182, 0.15) !important; border: 1px solid rgba(244, 114, 182, 0.25) !important; }
  :global(.badge-语阁) { color: #a78bfa !important; background: rgba(167, 139, 250, 0.15) !important; border: 1px solid rgba(167, 139, 250, 0.25) !important; }
  :global(.result-card-snippet) { font-size: 0.8rem; color: rgba(255, 255, 255, 0.55) !important; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  .modal-footer-hints { display: flex; align-items: center; gap: 1rem; padding: 0.625rem 1.125rem; background: rgba(0, 0, 0, 0.2); border-top: 1px solid rgba(255, 255, 255, 0.06); font-size: 0.72rem; color: rgba(255, 255, 255, 0.45); }
  .hint-item { display: flex; align-items: center; gap: 0.3125rem; }
  :global(.hint-item kbd), .hint-item kbd { background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 4px; padding: 2px 5px; font-size: 0.65rem; font-weight: 600; color: rgba(255, 255, 255, 0.7) !important; font-family: inherit; }

  /* 暗色/浅色主题平滑过渡 */
  :global(.light-mode) .search-modal-backdrop { background: rgba(255, 255, 255, 0.45); }
  :global(.light-mode) .search-modal-container { background: rgba(255, 255, 255, 0.96); border-color: rgba(0, 0, 0, 0.1); box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12); }
  :global(.light-mode) .modal-query-label { color: #1d1d1f; }
  :global(.light-mode) .modal-footer-hints { background: rgba(0, 0, 0, 0.03); border-top-color: rgba(0, 0, 0, 0.08); color: #666666 !important; }
  :global(.light-mode) .hint-item span { color: #555555 !important; }
  :global(.light-mode) .hint-item kbd, :global(.light-mode .hint-item kbd) { background: #ffffff !important; border: 1px solid rgba(0, 0, 0, 0.2) !important; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08) !important; color: #1d1d1f !important; font-weight: 700 !important; }
  :global(.light-mode .result-card-title) { color: #1d1d1f !important; }
  :global(.light-mode .result-card-snippet) { color: rgba(0, 0, 0, 0.65) !important; }
  :global(.light-mode .modal-result-item.selected), :global(.light-mode .modal-result-item:hover) { background: rgba(0, 0, 0, 0.06); }
</style>
