---
import { NAVBAR_CONFIG } from '../../config';

const menuTitle = NAVBAR_CONFIG.mobileMenuTitle || '菜单控制台';
const lyricTitle = NAVBAR_CONFIG.mobileLyricTitle || '实时歌词看板';
---
<div class="mobile-drawer-overlay" id="mobile-drawer-overlay"></div>

<div class="mobile-drawer" id="mobile-drawer">
  <div class="drawer-anim-item drawer-header">
    <span class="drawer-title">{menuTitle}</span>
    <button class="drawer-close-btn" id="mobile-drawer-close" aria-label="关闭菜单">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  </div>

  <!-- 1. 移动端导航菜单 -->
  <div class="drawer-nav-list">
    {NAVBAR_CONFIG.navItems.map((item, index) => (
      <a href={item.url} class="drawer-anim-item drawer-nav-item" style={`--anim-delay: ${0.1 + index * 0.05}s`}>
        <span>{item.label}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="arrow-icon"><path d="M9 18l6-6-6-6"/></svg>
      </a>
    ))}
  </div>

  <div class="drawer-anim-item drawer-divider" id="mobile-drawer-lyric-divider" style="--anim-delay: 0.25s"></div>

  <!-- 2. 移动端歌词收纳看板（默认隐藏，有音乐播放时开启） -->
  <div class="drawer-anim-item drawer-lyric-box" id="mobile-drawer-lyric-box" style="--anim-delay: 0.3s; display: none;">
    <div class="lyric-box-header">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="lyric-icon"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M8 8h8M8 12h5"/></svg>
      <span>{lyricTitle}</span>
    </div>
    <div class="lyric-box-content">
      <span id="mobile-drawer-lyric-text">正在等待歌词...</span>
    </div>
  </div>

  <!-- 3. 移动端专属独立提示框 (Alert Box) -->
  <div class="drawer-anim-item drawer-alert-box" id="mobile-drawer-alert" style="--anim-delay: 0.35s">
    <div class="countdown-circle-wrapper">
      <svg class="countdown-svg" viewBox="0 0 20 20">
        <circle class="countdown-bg" cx="10" cy="10" r="8"></circle>
        <circle class="countdown-bar" id="mobile-countdown-bar" cx="10" cy="10" r="8"></circle>
      </svg>
    </div>
    <span class="mobile-alert-text" id="mobile-alert-text-display"></span>
  </div>

  <div class="drawer-anim-item drawer-divider" style="--anim-delay: 0.4s"></div>

  <!-- 4. 移动端独立主题与性能控制按钮组 -->
  <div class="drawer-anim-item drawer-controls-row" style="--anim-delay: 0.45s">
    <button class="drawer-control-btn" id="mobile-theme-btn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="control-icon icon-sun"><circle cx="12" cy="12" r="5"/><path d="M12 2V4M12 20V22M4 12H2M22 12H20M19.0711 19.0711L17.6569 17.6569M6.34315 6.34315M4.92893 4.92893M19.0711 4.92893L17.6569 6.34315M6.34315 17.6569L4.92893 19.0711"/></svg>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="control-icon icon-moon"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
      <span class="btn-label">切换主题</span>
    </button>

    <button class="drawer-control-btn" id="mobile-perf-btn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="control-icon icon-perf-check"><circle cx="12" cy="12" r="10"/><path d="M22 4L12 14.01l-3-3"/></svg>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="control-icon icon-perf-warn"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      <span class="btn-label perf-high-text">性能模式</span>
      <span class="btn-label perf-low-text">效能模式</span>
    </button>
  </div>
</div>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    // === 1. 移动端歌词智能显隐与渐变淡入动画 ===
    const updateLyricVisibility = () => {
      const audio = window.__QUASAR_AUDIO_PLAYER__;
      const currentSong = audio?.currentSong;
      const hasAudio = !!(audio && (audio.src || (currentSong && currentSong.audioUrl)));

      const mobLyricBox = document.getElementById('mobile-drawer-lyric-box');
      const mobLyricDivider = document.getElementById('mobile-drawer-lyric-divider');

      if (mobLyricBox && mobLyricDivider) {
        if (hasAudio) {
          mobLyricBox.style.display = 'block';
          mobLyricDivider.style.display = 'block';
        } else {
          mobLyricBox.style.display = 'none';
          mobLyricDivider.style.display = 'none';
        }
      }
    };

// 监听全局歌词派发事件（适中的纯渐出渐入动画 + 防重叠校验）
    window.addEventListener('quasar:lyric-change', (e) => {
      const mobLyric = document.getElementById('mobile-drawer-lyric-text');
      if (!mobLyric) return;

      const newText = e.detail?.lyric || '正在等待歌词...';
      if (mobLyric.innerText !== newText) {
        if (window.gsap && !document.documentElement.classList.contains('perf-degraded')) {
          window.gsap.killTweensOf(mobLyric);
          
          window.gsap.to(mobLyric, {
            opacity: 0,
            duration: 0.12,
            ease: "power1.in",
            onComplete: () => {
              if (mobLyric) {
                mobLyric.innerText = newText;
                window.gsap.fromTo(mobLyric,
                  { opacity: 0 },
                  { opacity: 1, duration: 0.18, ease: "power1.out", force3D: true }
                );
              }
            }
          });
        } else {
          mobLyric.innerText = newText;
        }
      }
    });

    window.addEventListener('nav-update-music-ui', updateLyricVisibility);
    updateLyricVisibility();

    // === 2. 独立提示框状态与倒计时动画镜像同步 ===
    const mainAlert = document.getElementById('nav-perf-alert');
    const mainAlertText = document.getElementById('perf-alert-text');
    const mainBar = document.getElementById('countdown-circle-bar');

    const mobAlert = document.getElementById('mobile-drawer-alert');
    const mobAlertText = document.getElementById('mobile-alert-text-display');
    const mobBar = document.getElementById('mobile-countdown-bar');

    if (mainAlert && mobAlert) {
      const syncAlertState = () => {
        const style = window.getComputedStyle(mainAlert);
        const opacity = parseFloat(style.opacity || '0');
        const isVisible = (opacity > 0.01 && style.visibility !== 'hidden') || mainAlert.classList.contains('active');
        
        if (isVisible) mobAlert.classList.add('active');
        else mobAlert.classList.remove('active');
        
        if (mainAlertText && mobAlertText) mobAlertText.innerText = mainAlertText.innerText;
        
        if (mainAlert.classList.contains('is-red-warning')) mobAlert.classList.add('is-red-warning');
        else mobAlert.classList.remove('is-red-warning');
        
        if (mainBar && mobBar) mobBar.style.strokeDashoffset = mainBar.style.strokeDashoffset;
      };

      const observer = new MutationObserver(syncAlertState);
      observer.observe(mainAlert, { attributes: true, attributeFilter: ['style', 'class'] });
      if (mainAlertText) observer.observe(mainAlertText, { childList: true, characterData: true, subtree: true });
      if (mainBar) observer.observe(mainBar, { attributes: true, attributeFilter: ['style'] });
    }
  });
</script>

<style>
  @media (min-width: 769px) {
    .mobile-drawer-overlay, .mobile-drawer { display: none !important; }
  }

  @media (max-width: 768px) {
    .mobile-drawer-overlay {
      position: fixed; inset: 0; background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(8px);
      z-index: 998; opacity: 0; visibility: hidden; transition: opacity 0.3s ease, visibility 0.3s ease;
    }
    :global(.mobile-drawer-open) .mobile-drawer-overlay { opacity: 1; visibility: visible; }

    .mobile-drawer {
      position: fixed; top: 0; bottom: 0; right: 0; width: 80vw; max-width: 320px;
      height: 100%; height: 100vh; height: 100dvh; height: -webkit-fill-available;
      padding: 24px 20px calc(24px + env(safe-area-inset-bottom, 0px)); 
      overflow-y: auto; 
      background: rgba(16, 16, 24, 0.96); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
      border-left: 1px solid rgba(255, 255, 255, 0.1); z-index: 999;
      box-sizing: border-box; display: flex; flex-direction: column;
      transform: translateX(100%); transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    :global(.mobile-drawer-open) .mobile-drawer { transform: translateX(0); }

    .drawer-anim-item {
      opacity: 0;
      transform: translateY(12px);
      transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    :global(.mobile-drawer-open) .drawer-anim-item {
      opacity: 1;
      transform: translateY(0);
      transition-delay: var(--anim-delay, 0s);
    }

    .drawer-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; --anim-delay: 0.05s; flex-shrink: 0; }
    .drawer-title { font-weight: 700; font-size: 1.1rem; color: #ffffff; }
    .drawer-close-btn { background: none; border: none; color: #aaaaaa; cursor: pointer; padding: 4px; display: flex; }
    .drawer-close-btn svg { width: 22px; height: 22px; }

    .drawer-nav-list { display: flex; flex-direction: column; gap: 8px; flex-shrink: 0; }
    .drawer-nav-item {
      display: flex; align-items: center; justify-content: space-between;
      padding: 12px 14px; border-radius: 12px; background: rgba(255, 255, 255, 0.05);
      color: #ffffff; text-decoration: none; font-size: 0.95rem; font-weight: 500;
    }
    .drawer-nav-item:active { background: rgba(255, 255, 255, 0.12); }
    .arrow-icon { width: 16px; height: 16px; opacity: 0.6; }

    .drawer-divider { height: 1px; background: rgba(255, 255, 255, 0.08); margin: 20px 0; flex-shrink: 0; }

    .drawer-lyric-box { background: rgba(0, 0, 0, 0.3); border-radius: 12px; padding: 14px; border: 1px solid rgba(255, 255, 255, 0.06); flex-shrink: 0; }
    .lyric-box-header { display: flex; align-items: center; gap: 8px; font-size: 0.8rem; color: var(--themeColor, #015EFB); margin-bottom: 8px; font-weight: 600; }
    .lyric-icon { width: 16px; height: 16px; }
    .lyric-box-content { min-height: 40px; display: flex; align-items: center; }
    
    #mobile-drawer-lyric-text {
      font-size: 0.88rem; color: #e1e1e1; line-height: 1.4; word-break: break-all;
      transition: opacity 0.15s ease; will-change: opacity; display: block; width: 100%;
    }

    .drawer-alert-box {
      margin-top: 0; padding: 0 14px; max-height: 0; opacity: 0; overflow: hidden;
      border-radius: 12px; display: flex; align-items: center; gap: 10px;
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      background: rgba(255, 255, 255, 0.05); border: 1px solid transparent; color: #ffffff; flex-shrink: 0;
    }
    .drawer-alert-box.active {
      margin-top: 12px; padding: 12px 14px; max-height: 60px; opacity: 1;
      border-color: rgba(255, 255, 255, 0.1);
    }
    .drawer-alert-box.is-red-warning {
      background: rgba(255, 62, 24, 0.08); border-color: rgba(255, 62, 24, 0.2);
      color: #ff3e18; text-shadow: 0 0 12px rgba(255, 62, 24, 0.2);
    }

    .countdown-circle-wrapper { display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; position: relative; flex-shrink: 0; }
    .countdown-svg { width: 16px; height: 16px; transform: rotate(-90deg); }
    .countdown-bg { fill: none; stroke: rgba(255, 255, 255, 0.15); stroke-width: 2.5; }
    .countdown-bar { fill: none; stroke: currentColor; stroke-width: 2.5; stroke-linecap: round; stroke-dasharray: 50.26; stroke-dashoffset: 0; }
    .mobile-alert-text { font-size: 0.85rem; font-weight: 500; letter-spacing: 0.02em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    .drawer-controls-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: auto; padding-top: 16px; flex-shrink: 0; }
    .drawer-control-btn {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      padding: 12px; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.06); color: #ffffff; cursor: pointer; font-size: 0.85rem; font-weight: 600;
    }
    .control-icon { width: 18px; height: 18px; }

    .icon-sun { display: block; } .icon-moon { display: none; }
    :global(.light-mode) .icon-sun { display: none; }
    :global(.light-mode) .icon-moon { display: block; }

    .icon-perf-check { display: block; } .icon-perf-warn { display: none; }
    .perf-high-text { display: inline; } .perf-low-text { display: none; }

    :global(.perf-degraded) .icon-perf-check { display: none !important; }
    :global(.perf-degraded) .perf-high-text { display: none !important; }
    :global(.perf-degraded) .perf-low-text { display: inline !important; }

    @keyframes mobPulseWarnDark { 0%, 100% { color: #ffffff; opacity: 0.4; transform: scale(1); } 50% { color: #ff3e18; opacity: 1; transform: scale(1.08); } }
    @keyframes mobPulseWarnLight { 0%, 100% { color: #1d1d1f; opacity: 0.35; transform: scale(1); } 50% { color: #ff3e18; opacity: 1; transform: scale(1.08); } }
    
    :global(.perf-degraded) .drawer-control-btn .icon-perf-warn { 
      display: block !important; 
      animation: mobPulseWarnDark 2s cubic-bezier(0.5, 0, 0.2, 1) infinite !important;
      will-change: opacity, transform;
      filter: drop-shadow(0 0 6px rgba(255, 62, 24, 0.6));
    }
    :global(.perf-degraded.light-mode) .drawer-control-btn .icon-perf-warn {
      animation: mobPulseWarnLight 2s cubic-bezier(0.5, 0, 0.2, 1) infinite !important;
      filter: none;
    }

    :global(.perf-degraded) .mobile-drawer-overlay {
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
      background: rgba(0, 0, 0, 0.75) !important;
    }
    :global(.perf-degraded) .mobile-drawer {
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
      background: #0d0d14 !important;
    }

    :global(.light-mode) .mobile-drawer { background: rgba(245, 245, 247, 0.96); border-left-color: rgba(0, 0, 0, 0.1); }
    :global(.light-mode) .drawer-title, :global(.light-mode) .drawer-nav-item, :global(.light-mode) .drawer-control-btn { color: #1d1d1f; }
    :global(.light-mode) .drawer-nav-item { background: rgba(0, 0, 0, 0.04); }
    :global(.light-mode) .drawer-control-btn { background: rgba(0, 0, 0, 0.04); border-color: rgba(0, 0, 0, 0.08); }
    :global(.light-mode) .drawer-lyric-box { background: rgba(255, 255, 255, 0.7); border-color: rgba(0, 0, 0, 0.08); }
    :global(.light-mode) #mobile-drawer-lyric-text { color: #222222; }
    
    :global(.light-mode) .drawer-alert-box { color: #1d1d1f; background: rgba(0, 0, 0, 0.03); }
    :global(.light-mode) .drawer-alert-box.active { border-color: rgba(0, 0, 0, 0.08); }
    :global(.light-mode) .countdown-bg { stroke: rgba(0, 0, 0, 0.08); }

    :global(.perf-degraded.light-mode) .mobile-drawer,
    :global(html.light-mode.perf-degraded) .mobile-drawer {
      background: #f5f5f7 !important;
    }
  }
</style>