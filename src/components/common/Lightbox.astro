---
// src/components/common/Lightbox.astro
---
<!-- 引入 EXIF 读取库 -->
<script src="https://cdn.jsdelivr.net/npm/exifreader@4.21.0/dist/exif-reader.js" is:inline></script>

<div id="lightbox" class="lightbox-modal" role="dialog" aria-modal="true">
  <div class="lightbox-backdrop" id="lightbox-close-area"></div>
  
  <div class="lightbox-content">
    <div class="lightbox-header">
      <div class="meta-left">
        <span id="lightbox-index" class="meta-badge"></span>
        <span id="lightbox-date" class="meta-date"></span>
        <span id="lightbox-location" class="meta-location" style="display: none;"></span>
      </div>
      <button id="lightbox-close-btn" class="lightbox-close-btn" aria-label="关闭">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- 双图层缓冲区：开启 3D 景深与 GPU 硬件加速容器 -->
    <div class="media-frame-container" id="media-frame-container">
      <img id="lb-base-img" class="lightbox-layer opacity-hidden" alt="" draggable="false" />
      <img id="lb-temp-img" class="lightbox-layer opacity-hidden" alt="" draggable="false" />
      <div id="lb-loader" class="lightbox-loading-placeholder" style="display: none;"></div>
      
      <!-- 加载失败提示 -->
      <div id="lb-error-tip" class="lightbox-error-container" style="display: none;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <p>图片加载失败，请检查网络或链接</p>
      </div>
    </div>

    <div class="lightbox-footer" id="lightbox-footer">
      <div class="footer-meta">
        <p id="footer-title" class="footer-title"></p>
        <div id="lightbox-exif" class="exif-info-bar" style="display: none;">
          <span id="exif-camera" class="exif-item"></span>
          <span id="exif-param" class="exif-item"></span>
        </div>
      </div>
      <a id="footer-link" href="#" target="_blank" rel="noopener noreferrer" class="footer-link">
        新标签页打开
      </a>
    </div>

    <button id="prev-btn" class="nav-btn prev" aria-label="上一张">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 19l-7-7 7-7"/></svg>
    </button>
    <button id="next-btn" class="nav-btn next" aria-label="下一张">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 5l7 7-7 7"/></svg>
    </button>
  </div>
</div>

<script is:inline>
  (function() {
    if (window.__quasarLightboxInited) return;
    window.__quasarLightboxInited = true;

    let currentGallery = [];
    let activeIndex = 0;
    
    let isOpen = false;
    let isSwitching = false;

    let lastClickedTargetEl = null; 
    let activeOriginEl = null;      
    let touchStartX = 0;
    let touchStartY = 0;

    const isDegradedMode = () => document.documentElement.classList.contains('perf-degraded');

    // 移动端优先捕获触摸节点
    const captureTarget = (e) => {
      const target = e.target.closest('.media-box, img, [data-moment-id], [data-src]');
      if (target && !target.closest('#lightbox')) {
        lastClickedTargetEl = target;
      }
    };
    document.addEventListener('pointerdown', captureTarget, true);
    document.addEventListener('click', captureTarget, true);

    const calculateFitDimension = (imgEl, containerEl) => {
      const containerRect = containerEl.getBoundingClientRect();
      const naturalW = imgEl.naturalWidth || containerRect.width;
      const naturalH = imgEl.naturalHeight || containerRect.height;
      
      if (!containerRect.width || !containerRect.height) return null;

      const containerRatio = containerRect.width / containerRect.height;
      const imgRatio = naturalW / naturalH;

      let fitW, fitH;
      if (imgRatio > containerRatio) {
        fitW = containerRect.width;
        fitH = containerRect.width / imgRatio;
      } else {
        fitH = containerRect.height;
        fitW = containerRect.height * imgRatio;
      }

      return {
        fitW: fitW,
        fitH: fitH,
        cx: containerRect.left + containerRect.width / 2,
        cy: containerRect.top + containerRect.height / 2
      };
    };

    // 🔑 核心修复：严丝合缝剔除嵌套节点，实现绝对 1:1 索引对齐
    const resolveOriginElement = (imgUrl, index, originHint) => {
      if (originHint && originHint.nodeType === 1 && !originHint.closest('#lightbox')) {
        return originHint.closest('img, .media-box, [data-src]') || originHint;
      }

      if (lastClickedTargetEl && lastClickedTargetEl.nodeType === 1 && document.body.contains(lastClickedTargetEl)) {
        const grid = lastClickedTargetEl.closest('.detail-media-grid, .media-grid, .detail-card, .gallery-grid, .moments-grid, [data-gallery]');
        if (grid) {
          let rawItems = Array.from(grid.querySelectorAll('.media-box, img, [data-src]'));
          // 剔除所有包含在父容器内部的子元素，保持纯净顶层节点列表
          const uniqueItems = rawItems.filter(el => !rawItems.some(parent => parent !== el && parent.contains(el)));

          if (uniqueItems.length > 0 && uniqueItems[index]) {
            return uniqueItems[index];
          }
        }
        return lastClickedTargetEl.closest('img, .media-box, [data-src]') || lastClickedTargetEl;
      }

      if (imgUrl) {
        const cleanUrl = imgUrl.split('?')[0].split('#')[0];
        const fileName = cleanUrl.substring(cleanUrl.lastIndexOf('/') + 1);
        if (fileName && fileName.length > 3) {
          const allImgs = Array.from(document.querySelectorAll('img, .media-box, [data-src]'));
          const found = allImgs.find(el => {
            if (el.closest('#lightbox')) return false;
            const src = el.getAttribute('src') || el.getAttribute('data-src') || '';
            return src.includes(fileName);
          });
          if (found) return found;
        }
      }

      return null;
    };

    const parseAndShowExif = async (imgUrl) => {
      const exifContainer = document.getElementById('lightbox-exif');
      const exifCamera = document.getElementById('exif-camera');
      const exifParam = document.getElementById('exif-param');
      if (!exifContainer) return;

      if (typeof ExifReader === 'undefined' || !imgUrl || imgUrl.startsWith('data:')) {
        exifContainer.style.display = 'none';
        return;
      }

      try {
        const tags = await ExifReader.load(imgUrl, { async: true });
        const make = tags.Make ? tags.Make.description : '';
        const model = tags.Model ? tags.Model.description : '';
        let camera = model;
        if (make && model && !model.toLowerCase().includes(make.toLowerCase())) {
          camera = `${make} ${model}`;
        }

        const focalLength = tags.FocalLength ? `${tags.FocalLength.description}mm` : '';
        const fNumber = tags.FNumber ? `f/${tags.FNumber.description}` : '';
        const exposureTime = tags.ExposureTime ? `${tags.ExposureTime.description}s` : '';
        const iso = tags.ISOSpeedRatings || tags.ISO ? `ISO ${tags.ISOSpeedRatings?.description || tags.ISO?.description}` : '';

        const params = [focalLength, fNumber, exposureTime, iso].filter(Boolean).join('  ');

        if (camera || params) {
          if (camera && exifCamera) exifCamera.textContent = `📷 ${camera}`;
          if (params && exifParam) exifParam.textContent = `⚙️ ${params}`;
          exifContainer.style.display = 'flex';
        } else {
          exifContainer.style.display = 'none';
        }
      } catch (e) {
        exifContainer.style.display = 'none';
      }
    };

    const renderLightboxIndex = (index, direction = 'next', originElHint = null) => {
      if (!currentGallery || !currentGallery.length) return;
      if (isOpen && isSwitching) return;

      const lightbox = document.getElementById('lightbox');
      const lbBaseImg = document.getElementById('lb-base-img');
      const lbTempImg = document.getElementById('lb-temp-img');
      const lbLoader = document.getElementById('lb-loader');
      const lbErrorTip = document.getElementById('lb-error-tip');
      const containerEl = document.getElementById('media-frame-container');
      const lbIndex = document.getElementById('lightbox-index');
      const lbDate = document.getElementById('lightbox-date');
      const lbLocation = document.getElementById('lightbox-location');
      const footerLink = document.getElementById('footer-link');
      const footerTitle = document.getElementById('footer-title');

      if (!lightbox || !lbBaseImg || !lbTempImg || !containerEl) return;

      if (isOpen && index === activeIndex) return;

      const isNewOpen = !isOpen;
      activeIndex = index;
      const item = currentGallery[index];
      const imgUrl = typeof item === 'string' ? item : item.src;
      const isDegraded = isDegradedMode();

      activeOriginEl = resolveOriginElement(imgUrl, index, originElHint);
      let preOriginRect = null;
      if (activeOriginEl && activeOriginEl.getBoundingClientRect) {
        const r = activeOriginEl.getBoundingClientRect();
        if (r.width > 0 && r.height > 0) {
          preOriginRect = {
            cx: r.left + r.width / 2,
            cy: r.top + r.height / 2,
            width: r.width,
            height: r.height
          };
        }
      }

      if (lbErrorTip) lbErrorTip.style.display = 'none';
      lbBaseImg.style.display = 'block';
      lbTempImg.style.display = 'block';

      if (lbIndex) lbIndex.innerText = `#${index + 1} / ${currentGallery.length}`;
      if (lbDate) lbDate.innerText = item.date || '';
      
      if (lbLocation) {
        if (item.location) {
          lbLocation.innerText = `📍 ${item.location}`;
          lbLocation.style.display = 'inline-block';
        } else {
          lbLocation.style.display = 'none';
        }
      }

      if (footerTitle) footerTitle.innerText = item.title || '';
      if (footerLink) footerLink.href = imgUrl;

      if (isNewOpen) {
        isOpen = true;
        isSwitching = true;

        document.documentElement.classList.add('lightbox-open');
        document.body.classList.add('lightbox-open');
        lightbox.classList.add('active');

        if (window.gsap) {
          gsap.killTweensOf([lbBaseImg, lbTempImg, '.lightbox-content', '.lightbox-backdrop']);
          gsap.set(lbTempImg, { clearProps: "all", display: 'none', opacity: 0 });
          gsap.set(lbBaseImg, { clearProps: "all" });
        }

        lbBaseImg.className = 'lightbox-layer opacity-hidden';
        if (lbLoader) lbLoader.style.display = 'block';

        let hasAnimated = false;

        const animateFlyIn = () => {
          if (hasAnimated) return;
          hasAnimated = true;

          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              if (lbLoader) lbLoader.style.display = 'none';
              if (lbErrorTip) lbErrorTip.style.display = 'none';

              const fitData = calculateFitDimension(lbBaseImg, containerEl);

              if (window.gsap && !isDegraded && fitData && preOriginRect) {
                lbBaseImg.style.width = `${fitData.fitW}px`;
                lbBaseImg.style.height = `${fitData.fitH}px`;

                const deltaX = preOriginRect.cx - fitData.cx;
                const deltaY = preOriginRect.cy - fitData.cy;
                const scaleX = preOriginRect.width / fitData.fitW;
                const scaleY = preOriginRect.height / fitData.fitH;

                lbBaseImg.style.display = 'block';
                lbBaseImg.classList.remove('opacity-hidden');

                gsap.set(lbBaseImg, {
                  xPercent: -50,
                  yPercent: -50,
                  x: deltaX,
                  y: deltaY,
                  scaleX: scaleX,
                  scaleY: scaleY,
                  opacity: 1,
                  transformOrigin: "50% 50%",
                  force3D: true
                });

                gsap.fromTo('.lightbox-content',
                  { opacity: 0 },
                  { opacity: 1, duration: 0.25, ease: "power2.out", force3D: true }
                );

                gsap.to(lbBaseImg, {
                  x: 0,
                  y: 0,
                  scaleX: 1,
                  scaleY: 1,
                  duration: 0.38,
                  ease: "power3.out",
                  force3D: true,
                  onComplete: () => { isSwitching = false; }
                });
              } else {
                lbBaseImg.style.display = 'block';
                lbBaseImg.classList.remove('opacity-hidden');
                if (window.gsap && !isDegraded) {
                  gsap.fromTo('.lightbox-content', { opacity: 0 }, { opacity: 1, duration: 0.25, ease: "power2.out", force3D: true });
                  gsap.fromTo(lbBaseImg,
                    { xPercent: -50, yPercent: -50, scale: 0.88, opacity: 0, x: 0, y: 0 },
                    { scale: 1, opacity: 1, duration: 0.35, ease: "power3.out", force3D: true, onComplete: () => { isSwitching = false; } }
                  );
                } else {
                  isSwitching = false;
                }
              }
            });
          });
        };

        const handleImageError = () => {
          if (hasAnimated) return;
          hasAnimated = true;

          if (lbLoader) lbLoader.style.display = 'none';
          lbBaseImg.style.display = 'none';
          if (lbErrorTip) lbErrorTip.style.display = 'flex';
          if (footerTitle) footerTitle.innerText = item.title || '图片加载失败，可尝试在新标签页打开';

          if (window.gsap && !isDegraded) {
            gsap.fromTo('.lightbox-content', { opacity: 0 }, { opacity: 1, duration: 0.3, ease: "power2.out", force3D: true });
          }
          isSwitching = false;
        };

        lbBaseImg.onload = animateFlyIn;
        lbBaseImg.onerror = handleImageError;

        lbBaseImg.src = imgUrl;
        if (lbBaseImg.complete) {
          if (lbBaseImg.naturalWidth === 0) handleImageError();
          else animateFlyIn();
        }

        parseAndShowExif(imgUrl);
      } 
      else {
        isSwitching = true;
        if (lbLoader) lbLoader.style.display = 'block';

        const currentImg = lbBaseImg;
        const nextImg = lbTempImg;

        const exitX = direction === 'next' ? '-100%' : '100%';
        const enterX = direction === 'next' ? '100%' : '-100%';

        let loadFinished = false;
        let hasError = false;

        const handleNextLoad = () => {
          if (loadFinished) return;
          loadFinished = true;
          hasError = false;

          const fitData = calculateFitDimension(nextImg, containerEl);
          if (fitData) {
            nextImg.style.width = `${fitData.fitW}px`;
            nextImg.style.height = `${fitData.fitH}px`;
          }

          if (lbLoader) lbLoader.style.display = 'none';
          if (lbErrorTip) lbErrorTip.style.display = 'none';
          nextImg.style.display = 'block';
          nextImg.classList.remove('opacity-hidden');
        };

        const handleNextError = () => {
          if (loadFinished) return;
          loadFinished = true;
          hasError = true;
          if (lbLoader) lbLoader.style.display = 'none';
          nextImg.style.display = 'none';
          if (lbErrorTip) lbErrorTip.style.display = 'flex';
          if (footerTitle) footerTitle.innerText = item.title || '图片加载失败，可尝试在新标签页打开';
        };

        nextImg.onload = handleNextLoad;
        nextImg.onerror = handleNextError;

        nextImg.src = imgUrl;
        if (nextImg.complete) {
          if (nextImg.naturalWidth > 0) handleNextLoad();
          else handleNextError();
        }

        if (window.gsap && !isDegraded) {
          gsap.set(nextImg, { xPercent: -50, yPercent: -50, x: enterX, opacity: 0.6, display: hasError ? 'none' : 'block', scaleX: 1, scaleY: 1, force3D: true });
          gsap.set(currentImg, { xPercent: -50, yPercent: -50, x: '0%', opacity: 1, scaleX: 1, scaleY: 1, force3D: true });

          const tl = gsap.timeline({
            onComplete: () => {
              if (hasError) {
                currentImg.src = '';
                currentImg.style.display = 'none';
                if (lbErrorTip) lbErrorTip.style.display = 'flex';
                if (footerTitle) footerTitle.innerText = item.title || '图片加载失败，可尝试在新标签页打开';
              } else {
                currentImg.src = imgUrl;
                const currentFit = calculateFitDimension(currentImg, containerEl);
                if (currentFit) {
                  currentImg.style.width = `${currentFit.fitW}px`;
                  currentImg.style.height = `${currentFit.fitH}px`;
                }
                currentImg.style.display = 'block';
                currentImg.classList.remove('opacity-hidden');
                if (lbErrorTip) lbErrorTip.style.display = 'none';
              }

              gsap.set(currentImg, { xPercent: -50, yPercent: -50, x: '0%', opacity: 1, scaleX: 1, scaleY: 1, force3D: true });
              gsap.set(nextImg, { xPercent: -50, yPercent: -50, x: '0%', opacity: 0, display: 'none', force3D: true });
              nextImg.classList.add('opacity-hidden');
              nextImg.src = '';

              parseAndShowExif(imgUrl);
              isSwitching = false;
            }
          });

          tl.to(currentImg, { x: exitX, opacity: 0, duration: 0.32, ease: "power3.out", force3D: true }, 0);
          tl.to(nextImg, { x: '0%', opacity: hasError ? 0 : 1, duration: 0.32, ease: "power3.out", force3D: true }, 0);

        } else {
          if (hasError) {
            currentImg.src = '';
            currentImg.style.display = 'none';
            if (lbErrorTip) lbErrorTip.style.display = 'flex';
          } else {
            currentImg.src = imgUrl;
            currentImg.style.display = 'block';
            currentImg.classList.remove('opacity-hidden');
          }
          parseAndShowExif(imgUrl);
          isSwitching = false;
        }
      }
    };

    window.openLightbox = (images, index = 0, meta = {}, originEl = null) => {
      if (!images || !images.length) return;
      currentGallery = images.map(img => {
        if (typeof img === 'string') {
          return { src: img, date: meta.date || '', location: meta.location || '', title: meta.title || '' };
        }
        return img;
      });
      renderLightboxIndex(index, 'next', originEl);
    };

    const closeLightbox = () => {
      if (!isOpen) return;

      const lightbox = document.getElementById('lightbox');
      const lbBaseImg = document.getElementById('lb-base-img');
      const containerEl = document.getElementById('media-frame-container');
      const lbLoader = document.getElementById('lb-loader');
      const lbErrorTip = document.getElementById('lb-error-tip');
      const exifContainer = document.getElementById('lightbox-exif');
      const backdrop = document.getElementById('lightbox-close-area');
      if (!lightbox) return;

      isOpen = false;
      isSwitching = false;

      let closingOriginRect = null;
      if (currentGallery[activeIndex]) {
        const currentUrl = typeof currentGallery[activeIndex] === 'string' ? currentGallery[activeIndex] : currentGallery[activeIndex].src;
        const targetEl = resolveOriginElement(currentUrl, activeIndex, null);
        if (targetEl && targetEl.getBoundingClientRect) {
          const r = targetEl.getBoundingClientRect();
          if (r.width > 0 && r.height > 0) {
            closingOriginRect = {
              cx: r.left + r.width / 2,
              cy: r.top + r.height / 2,
              width: r.width,
              height: r.height
            };
          }
        }
      }

      const fitData = lbBaseImg && containerEl ? calculateFitDimension(lbBaseImg, containerEl) : null;
      const isDegraded = isDegradedMode();

      const doClose = () => {
        lightbox.classList.remove('active');
        document.documentElement.classList.remove('lightbox-open');
        document.body.classList.remove('lightbox-open');

        if (lbBaseImg) {
          lbBaseImg.src = '';
          lbBaseImg.style.width = '';
          lbBaseImg.style.height = '';
          lbBaseImg.style.display = 'block';
          if (window.gsap) gsap.set(lbBaseImg, { clearProps: "all" });
        }
        if (lbLoader) lbLoader.style.display = 'none';
        if (lbErrorTip) lbErrorTip.style.display = 'none';
        if (exifContainer) exifContainer.style.display = 'none';
        if (backdrop) backdrop.style.opacity = '';
      };

      if (window.gsap && !isDegraded && lbBaseImg && fitData && closingOriginRect) {
        const deltaX = closingOriginRect.cx - fitData.cx;
        const deltaY = closingOriginRect.cy - fitData.cy;
        const scaleX = closingOriginRect.width / fitData.fitW;
        const scaleY = closingOriginRect.height / fitData.fitH;

        gsap.to(lbBaseImg, {
          xPercent: -50,
          yPercent: -50,
          x: deltaX,
          y: deltaY,
          scaleX: scaleX,
          scaleY: scaleY,
          opacity: 0,
          duration: 0.32,
          ease: "power2.inOut",
          force3D: true
        });

        gsap.to('.lightbox-content', { opacity: 0, duration: 0.25, ease: "power2.in" });
        gsap.to('.lightbox-backdrop', { opacity: 0, duration: 0.32, ease: "power2.inOut", onComplete: doClose });
      } else {
        doClose();
      }
    };

    const initLightboxEvents = () => {
      const closeBtn = document.getElementById('lightbox-close-btn');
      const closeArea = document.getElementById('lightbox-close-area');
      const prevBtn = document.getElementById('prev-btn');
      const nextBtn = document.getElementById('next-btn');
      const contentEl = document.querySelector('.lightbox-content');

      if (closeBtn) closeBtn.onclick = closeLightbox;
      if (closeArea) closeArea.onclick = closeLightbox;

      if (prevBtn) prevBtn.onclick = () => { if (activeIndex > 0) renderLightboxIndex(activeIndex - 1, 'prev'); };
      if (nextBtn) nextBtn.onclick = () => { if (activeIndex < currentGallery.length - 1) renderLightboxIndex(activeIndex + 1, 'next'); };

      if (contentEl) {
        contentEl.addEventListener('touchstart', (e) => {
          if (e.touches.length === 1) {
            touchStartX = e.touches[0].clientX;
            touchStartY = e.touches[0].clientY;
          }
        }, { passive: true });

        contentEl.addEventListener('touchend', (e) => {
          if (e.changedTouches.length !== 1) return;

          const deltaX = e.changedTouches[0].clientX - touchStartX;
          const deltaY = e.changedTouches[0].clientY - touchStartY;

          if (Math.abs(deltaX) > 40 && Math.abs(deltaX) > Math.abs(deltaY) * 1.4) {
            if (deltaX < 0 && activeIndex < currentGallery.length - 1) {
              renderLightboxIndex(activeIndex + 1, 'next');
            } else if (deltaX > 0 && activeIndex > 0) {
              renderLightboxIndex(activeIndex - 1, 'prev');
            }
          } 
          else if (deltaY > 100 && Math.abs(deltaY) > Math.abs(deltaX) * 1.5) {
            closeLightbox();
          }
        }, { passive: true });
      }

      document.removeEventListener('keydown', handleKeydown);
      document.addEventListener('keydown', handleKeydown);
    };

    function handleKeydown(e) {
      const lightbox = document.getElementById('lightbox');
      if (!lightbox || !lightbox.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft' && activeIndex > 0) renderLightboxIndex(activeIndex - 1, 'prev');
      if (e.key === 'ArrowRight' && activeIndex < currentGallery.length - 1) renderLightboxIndex(activeIndex + 1, 'next');
    }

    document.addEventListener('DOMContentLoaded', initLightboxEvents);
    document.addEventListener('astro:page-load', initLightboxEvents);
    
    window.removeEventListener('quasar:open-lightbox', window.__quasarOpenLbHandler);
    window.__quasarOpenLbHandler = (e) => {
      if (e.detail) {
        const originEl = e.detail.originEl || (e.target && e.target !== window ? e.target : null);
        window.openLightbox(e.detail.images, e.detail.index || 0, e.detail.meta || {}, originEl);
      }
    };
    window.addEventListener('quasar:open-lightbox', window.__quasarOpenLbHandler);
  })();
</script>

<style is:global>
  html {
    scrollbar-gutter: stable;
  }

  html.lightbox-open, body.lightbox-open {
    overflow: hidden !important;
    touch-action: none;
  }

  .media-frame-container { 
    flex-grow: 1; 
    display: block; 
    overflow: hidden; 
    position: relative; 
    width: 100%; 
    height: 72vh; 
    height: 72dvh;
    margin: 10px 0; 
    perspective: 1200px;
    transform-style: preserve-3d;
  }
  
  .lightbox-layer { 
    position: absolute; 
    left: 50%;
    top: 50%;
