---
// src/components/widgets/QuoteWidget.astro
import { SITE_CONFIG } from '../../config.ts';

const defaultQuotes = [
  "穿越逆境，直抵繁星。",
  "保持熱愛，奔赴山海。",
];
const quotesList = (SITE_CONFIG as any).quotes || defaultQuotes;
---
<div class="glass-widget quote-card">
  <div class="quote-header">
    <span class="quote-tag">DAILY QUOTE</span>
    <button id="refresh-quote-btn" class="breathing-sphere-btn" title="點擊切換">
      <span class="ring-core"></span>
      <span class="ring-outer" id="ring-outer-el"></span>
    </button>
  </div>
  <div class="quote-body">
    <p class="quote-content" id="widget-quote-text"></p>
    <div class="quote-author-wrapper">
      <span class="quote-author" id="widget-quote-author"></span>
    </div>
  </div>
</div>

<script define:vars={{ quotesList }}>
  document.addEventListener('astro:page-load', () => {
    const parseQuote = (item) => {
      if (!item) return { text: '', author: '' };
      if (typeof item === 'object' && item.text) return { text: item.text, author: item.author || '' };
      if (typeof item === 'string') {
        if (item.includes('——')) return { text: item.split('——')[0].trim(), author: item.split('——')[1].trim() };
        if (item.includes('|')) return { text: item.split('|')[0].trim(), author: item.split('|')[1].trim() };
        return { text: item.trim(), author: '' };
      }
      return { text: String(item), author: '' };
    };

    let currentQuoteIdx = 0;
    const quoteTextEl = document.getElementById('widget-quote-text');
    const quoteAuthorEl = document.getElementById('widget-quote-author');
    const refreshQuoteBtn = document.getElementById('refresh-quote-btn');
    const ringOuterEl = document.getElementById('ring-outer-el');

    const updateQuoteDisplay = (idx) => {
      const parsed = parseQuote(quotesList[idx]);
      if (quoteTextEl) quoteTextEl.innerText = parsed.text;
      if (quoteAuthorEl) quoteAuthorEl.innerText = parsed.author ? `— ${parsed.author}` : '';
    };

    const switchNextQuote = () => {
      if (!quotesList || quotesList.length <= 1) return;
      if (typeof gsap !== 'undefined') {
        gsap.to([quoteTextEl, quoteAuthorEl], {
          opacity: 0, y: -4, duration: 0.2,
          onComplete: () => {
            currentQuoteIdx = (currentQuoteIdx + 1) % quotesList.length;
            updateQuoteDisplay(currentQuoteIdx);
            gsap.to([quoteTextEl, quoteAuthorEl], { opacity: 1, y: 0, duration: 0.3 });
          }
        });
      } else {
        currentQuoteIdx = (currentQuoteIdx + 1) % quotesList.length;
        updateQuoteDisplay(currentQuoteIdx);
      }
    };

    updateQuoteDisplay(0);

    let breathCount = 0;
    if (ringOuterEl) {
      ringOuterEl.addEventListener('animationiteration', () => {
        breathCount++;
        if (breathCount >= 5) { breathCount = 0; switchNextQuote(); }
      });
    }

    if (refreshQuoteBtn && quotesList && quotesList.length > 0) {
      refreshQuoteBtn.addEventListener('click', () => {
        breathCount = 0;
        refreshQuoteBtn.classList.add('is-clicked');
        switchNextQuote();
        setTimeout(() => refreshQuoteBtn.classList.remove('is-clicked'), 400);
      });
    }

    // === 🌟 支持低性能模式静音的磁吸逻辑 ===
    if (typeof gsap !== 'undefined' && typeof Draggable !== 'undefined') {
      const card = document.querySelector('.quote-card');
      if (card && card.parentNode) {
        const existing = Draggable.get(card);
        if (existing) existing.kill();

        const SNAP_THRESHOLD = 220;

        let canvas = card.parentNode.querySelector('.quote-magnetic-canvas');
        if (!canvas) {
          canvas = document.createElement('canvas');
          canvas.className = 'quote-magnetic-canvas';
          card.parentNode.insertBefore(canvas, card);
        }
        const ctx = canvas.getContext('2d');

        // ⚡ 检测低性能模式状态
        const isLowPerfMode = () => {
          const navbar = document.getElementById('quasar-navbar-element');
          return (typeof window._quasarAnimationSpeedMultiplier !== 'undefined' && window._quasarAnimationSpeedMultiplier < 0.5) ||
                 (navbar && navbar.classList.contains('perf-degraded'));
        };

        const updateCanvasDimensions = () => {
          if (isLowPerfMode()) return;
          const rect = card.getBoundingClientRect();
          canvas.width = rect.width + SNAP_THRESHOLD * 2;
          canvas.height = rect.height + SNAP_THRESHOLD * 2;
          
          const initialLeft = card.offsetLeft - SNAP_THRESHOLD;
          const initialTop = card.offsetTop - SNAP_THRESHOLD;
          
          canvas.style.position = 'absolute';
          canvas.style.left = `${initialLeft}px`;
          canvas.style.top = `${initialTop}px`;
          canvas.style.pointerEvents = 'none';
          canvas.style.zIndex = '0';
        };
        updateCanvasDimensions();

        let particles = [];
        let animFrameId = null;
        let isSnapping = false;

        const getThemeColor = () => {
          const color = getComputedStyle(card).getPropertyValue('--themeColor').trim();
          return color || '#015EFB';
        };

        const getRoundedRectPoint = (x, y, w, h, r, p) => {
          r = Math.min(r, w / 2, h / 2);
          const wSeg = w - 2 * r;
          const hSeg = h - 2 * r;
          const arcLen = (Math.PI / 2) * r;
          const L = 2 * wSeg + 2 * hSeg + 4 * arcLen;
          let d = ((p % 1) + 1) % 1 * L;

          if (d < wSeg) return { x: x + r + d, y: y, nx: 0, ny: -1 };
          d -= wSeg;
          if (d < arcLen) {
            const a = -Math.PI / 2 + (d / arcLen) * (Math.PI / 2);
            return { x: x + w - r + Math.cos(a) * r, y: y + r + Math.sin(a) * r, nx: Math.cos(a), ny: Math.sin(a) };
          }
          d -= arcLen;
          if (d < hSeg) return { x: x + w, y: y + r + d, nx: 1, ny: 0 };
          d -= hSeg;
          if (d < arcLen) {
            const a = (d / arcLen) * (Math.PI / 2);
            return { x: x + w - r + Math.cos(a) * r, y: y + h - r + Math.sin(a) * r, nx: Math.cos(a), ny: Math.sin(a) };
          }
          d -= arcLen;
          if (d < wSeg) return { x: x + w - r - d, y: y + h, nx: 0, ny: 1 };
          d -= wSeg;
          if (d < arcLen) {
            const a = Math.PI / 2 + (d / arcLen) * (Math.PI / 2);
            return { x: x + r + Math.cos(a) * r, y: y + h - r + Math.sin(a) * r, nx: Math.cos(a), ny: Math.sin(a) };
          }
          d -= arcLen;
          if (d < hSeg) return { x: x, y: y + h - r - d, nx: -1, ny: 0 };
          d -= hSeg;
          const a = Math.PI + (d / arcLen) * (Math.PI / 2);
          return { x: x + r + Math.cos(a) * r, y: y + r + Math.sin(a) * r, nx: Math.cos(a), ny: Math.sin(a) };
        };

        const renderParticles = (curX, curY) => {
          // ⚡ 低性能模式：完全关掉并清空粒子效果
          if (isLowPerfMode()) {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles = [];
            if (animFrameId) {
              cancelAnimationFrame(animFrameId);
              animFrameId = null;
            }
            return;
          }

          ctx.clearRect(0, 0, canvas.width, canvas.height);

          const dist = Math.hypot(curX, curY);
          const w = card.offsetWidth;
          const h = card.offsetHeight;
          const borderRadius = parseFloat(getComputedStyle(card).borderRadius) || 20;

          const homeX = SNAP_THRESHOLD;
          const homeY = SNAP_THRESHOLD;
          const cardX = SNAP_THRESHOLD + curX;
          const cardY = SNAP_THRESHOLD + curY;

          if (dist < SNAP_THRESHOLD && dist > 2) {
            const pullRatio = 1 - (dist / SNAP_THRESHOLD);
            const pullCurve = Math.pow(pullRatio, 1.1);
            
            const spawnCount = Math.floor(pullCurve * 42) + 6;
            const themeColor = getThemeColor();

            for (let i = 0; i < spawnCount; i++) {
              const p = Math.random();
              const p1 = getRoundedRectPoint(cardX, cardY, w, h, borderRadius, p);
              const p2 = getRoundedRectPoint(homeX, homeY, w, h, borderRadius, p);

              const isBorderHugger = Math.random() < 0.55;

              particles.push({
                x: p1.x + p1.nx * (Math.random() - 0.5) * 1.5,
                y: p1.y + p1.ny * (Math.random() - 0.5) * 1.5,
                targetX: isBorderHugger ? (p1.x + p1.nx * (Math.random() - 0.5) * 3) : p2.x,
                targetY: isBorderHugger ? (p1.y + p1.ny * (Math.random() - 0.5) * 3) : p2.y,
                size: Math.random() * 0.8 + 0.4,
                alpha: pullCurve * (0.6 + Math.random() * 0.4),
                color: themeColor,
                speed: isBorderHugger ? (0.012 + Math.random() * 0.02) : (0.02 + Math.random() * 0.04 * (pullCurve + 0.4)),
                progress: 0,
                twinklePhase: Math.random() * Math.PI * 2,
                curveAmp: isBorderHugger ? 0 : (Math.random() - 0.5) * 24 * (1 - pullCurve)
              });
            }
          }

          ctx.save();
          ctx.globalCompositeOperation = 'lighter';

          for (let i = particles.length - 1; i >= 0; i--) {
            const pt = particles[i];
            pt.progress += pt.speed;
            pt.twinklePhase += 0.25;

            const linearX = pt.x + (pt.targetX - pt.x) * pt.progress;
            const linearY = pt.y + (pt.targetY - pt.y) * pt.progress;
            const perpX = -(pt.targetY - pt.y);
            const perpY = pt.targetX - pt.x;
            const len = Math.hypot(perpX, perpY) || 1;
            const curveOffset = Math.sin(pt.progress * Math.PI) * pt.curveAmp;

            const drawX = linearX + (perpX / len) * curveOffset;
            const drawY = linearY + (perpY / len) * curveOffset;

            const twinkle = 0.8 + 0.2 * Math.sin(pt.twinklePhase);
            const currentAlpha = pt.alpha * (1 - pt.progress) * twinkle;

            if (pt.progress >= 1 || currentAlpha <= 0) {
              particles.splice(i, 1);
              continue;
            }

            ctx.beginPath();
            ctx.arc(drawX, drawY, pt.size, 0, Math.PI * 2);
            ctx.fillStyle = pt.color;
            ctx.globalAlpha = currentAlpha;
            ctx.shadowColor = pt.color;
            ctx.shadowBlur = 6;
            ctx.fill();
          }
          ctx.restore();

          if (particles.length > 0 || isSnapping || (dragger && dragger.isDragging && dist < SNAP_THRESHOLD)) {
            animFrameId = requestAnimationFrame(() => renderParticles(dragger.x, dragger.y));
          } else {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            cancelAnimationFrame(animFrameId);
            animFrameId = null;
          }
        };

        const startLoop = () => {
          if (isLowPerfMode()) return;
          if (!animFrameId) {
            animFrameId = requestAnimationFrame(() => renderParticles(dragger.x, dragger.y));
          }
        };

        const dragger = Draggable.create(card, {
          type: "x,y",
          edgeResistance: 0,
          dragResistance: 0,
          onDragStart: function() {
            updateCanvasDimensions();
            startLoop();
          },
          onDrag: function() {
            startLoop();
          },
          onRelease: function() {
            const dist = Math.hypot(this.x, this.y);
            if (dist < SNAP_THRESHOLD) {
              isSnapping = true;
              gsap.to(this.target, {
                x: 0,
                y: 0,
                duration: 0.5,
                ease: "back.out(1.2)",
                onUpdate: () => {
                  dragger.x = gsap.getProperty(this.target, "x");
                  dragger.y = gsap.getProperty(this.target, "y");
                },
                onComplete: () => {
                  isSnapping = false;
                  gsap.set(this.target, { clearProps: "transform" });
                  ctx.clearRect(0, 0, canvas.width, canvas.height);
                }
              });
            } else {
              isSnapping = false;
            }
          }
        })[0];
      }
    }
  });
</script>

<style>
  .quote-card { 
    padding: 18px 22px; 
    cursor: grab;
    touch-action: none;
    user-select: none;
    will-change: transform;
    position: relative;
    z-index: 1;
  }
  .quote-card:active { cursor: grabbing; }

  .quote-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }
  .quote-tag { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.65rem; font-weight: 800; letter-spacing: 0.12em; color: rgba(255, 255, 255, 0.4); }
  
  .breathing-sphere-btn { position: relative; width: 22px; height: 22px; background: none; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; outline: none; padding: 0; z-index: 10; }
  .ring-core { position: absolute; width: 7px; height: 7px; border-radius: 50%; background-color: var(--themeColor, #015EFB); box-shadow: 0 0 6px var(--themeColor, #015EFB); animation: ring-core-breath 2.4s infinite ease-in-out; }
  .ring-outer { position: absolute; width: 7px; height: 7px; border-radius: 50%; background-color: var(--themeColor, #015EFB); opacity: 0.33; animation: ring-outer-breath 2.4s infinite ease-in-out; }
  
  @keyframes ring-core-breath { 0%, 100% { transform: scale(0.9); opacity: 1; } 50% { transform: scale(1.3); opacity: 1; } }
  @keyframes ring-outer-breath { 0%, 100% { transform: scale(1); opacity: 0.33; } 50% { transform: scale(2.4); opacity: 0.33; } }
  .breathing-sphere-btn.is-clicked .ring-core, .breathing-sphere-btn.is-clicked .ring-outer { animation: ring-click-pop 0.4s ease-out; }
  @keyframes ring-click-pop { 0% { transform: scale(1); } 50% { transform: scale(1.8); } 100% { transform: scale(1); } }
  
  .quote-body { display: flex; flex-direction: column; gap: 4px; width: 100%; }
  .quote-content { font-size: 0.85rem; color: #dddddd; line-height: 1.5; letter-spacing: 0.02em; }
  .quote-author-wrapper { display: flex; justify-content: flex-end; width: 100%; margin-top: 2px; }
  .quote-author { font-size: 0.68rem; color: rgba(255, 255, 255, 0.3); font-family: 'Plus Jakarta Sans', 'Noto Sans SC', sans-serif; letter-spacing: 0.03em; text-align: right; }

  :global(html.light-mode) .quote-content { color: #1d1d1f !important; }
  :global(html.light-mode) .quote-author { color: rgba(0, 0, 0, 0.3) !important; }
  :global(html.light-mode) .quote-tag { color: rgba(0, 0, 0, 0.45) !important; }
</style>
