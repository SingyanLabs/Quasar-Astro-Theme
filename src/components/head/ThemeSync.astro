---
// src/components/head/ThemeSync.astro
---
<script is:inline>
  (function() {
    // 核心切换函数
    function updateTheme() {
      try {
        const savedTheme = localStorage.getItem('theme');
        const systemLight = window.matchMedia('(prefers-color-scheme: light)').matches;

        // 仅当明确手动点击并保存了 'light' 或 'dark' 时才锁定；其余（null / 'system' / 'auto'）一律跟随系统
        const isLight = savedTheme === 'light' || (!savedTheme && systemLight) || (savedTheme === 'auto' && systemLight);

        if (isLight) {
          document.documentElement.classList.add('light-mode');
        } else {
          document.documentElement.classList.remove('light-mode');
        }
      } catch (e) {}
    }

    // 1. 首次加载立即执行
    updateTheme();

    // 2. 监听系统深浅色实时切换
    const mediaQuery = window.matchMedia('(prefers-color-scheme: light)');
    const handleSystemChange = () => {
      const savedTheme = localStorage.getItem('theme');
      if (!savedTheme || savedTheme === 'system' || savedTheme === 'auto') {
        updateTheme();
      }
    };

    if (mediaQuery.addEventListener) {
      mediaQuery.addEventListener('change', handleSystemChange);
    } else if (mediaQuery.addListener) {
      mediaQuery.addListener(handleSystemChange);
    }

    // 3. 防御 Astro ClientRouter SPA 切页：在新页面渲染前/后强制保持主题
    document.addEventListener('astro:before-swap', (e) => {
      const isLight = document.documentElement.classList.contains('light-mode');
      if (isLight) {
        e.newDocument.documentElement.classList.add('light-mode');
      } else {
        e.newDocument.documentElement.classList.remove('light-mode');
      }
    });

    document.addEventListener('astro:after-swap', updateTheme);
  })();
</script>