---
// src/components/head/ThemePerfInit.astro
---
<script is:inline>
  (function() {
    try {
      const perf = localStorage.getItem('quasar-perf');
      if (perf === 'degraded') document.documentElement.classList.add('perf-degraded');
      else if (perf === 'high') document.documentElement.classList.remove('perf-degraded');
    } catch(e) {}
  })();
</script>