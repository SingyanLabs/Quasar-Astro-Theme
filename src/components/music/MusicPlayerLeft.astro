---
// src/components/music/MusicPlayerLeft.astro
---
<div class="music-left-player">
  <div class="music-cover-box" id="cover-box">
    <div id="music-cover" class="music-cover-img"></div>
  </div>

  <div class="music-timeline-box" id="progress-container">
    <div class="music-progress-track">
      <div class="music-progress-fill" id="progress-fill"></div>
    </div>
    <div class="music-time-row">
      <span id="time-current" class="tabular-time">0:00</span>
      <span id="quality-badge" class="music-quality-badge">解析数据中...</span>
      <span id="time-remaining" class="tabular-time">-0:00</span>
    </div>
  </div>

  <div class="music-meta">
    <h1 id="music-title" class="music-song-title">曲目加载中...</h1>
    <p id="music-artist-album" class="music-song-sub">Artist — Album</p>
  </div>

  <div class="music-controls">
    <!-- ID 全部添加 player- 前缀，杜绝与 Navbar 冲突 -->
    <button type="button" class="music-ctrl-btn" id="player-btn-prev" title="上一首" aria-label="上一首">
      <svg viewBox="0 0 24 24"><path fill="currentColor" d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
    </button>
    
    <button type="button" class="music-play-main" id="player-btn-play" title="播放 / 暂停" aria-label="播放或暂停">
      <div class="music-icon-wrapper">
        <svg class="music-icon icon-play" viewBox="0 0 24 24"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
        <svg class="music-icon icon-pause" viewBox="0 0 24 24"><path fill="currentColor" d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
        <svg class="music-icon icon-loading" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2A10 10 0 1 0 22 12 A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8z" opacity="0.25"/><path fill="currentColor" d="M12 4a8 8 0 0 1 8 8h-2a6 6 0 0 0-6-6V4z"><animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="0.75s" repeatCount="indefinite"/></path></svg>
      </div>
    </button>

    <button type="button" class="music-ctrl-btn" id="player-btn-next" title="下一首" aria-label="下一首">
      <svg viewBox="0 0 24 24"><path fill="currentColor" d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
    </button>

    <button type="button" class="music-ctrl-btn" id="player-btn-mode" title="列表循环" aria-label="切换播放模式">
      <svg class="icon-mode icon-order" viewBox="0 0 24 24"><path fill="currentColor" d="M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4z"/></svg>
      <svg class="icon-mode icon-shuffle" viewBox="0 0 24 24" style="display:none;"><path fill="currentColor" d="M10.59 9.17L5.41 4L4 5.41l5.17 5.17 1.42-1.41zM14.5 4l2.04 2.04L4 18.59 5.41 20 17.96 7.45 20 9.5V4h-5.5zm.33 9.41l-1.41 1.41 3.13 3.13L14.5 20H20v-5.5l-2.04 2.04-3.13-3.13z"/></svg>
      <svg class="icon-mode icon-repeat-one" viewBox="0 0 24 24" style="display:none;"><path fill="currentColor" d="M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4zm-3-3V9h-1l-2 1v1h1.5v4H14z"/></svg>
    </button>
    
    <button type="button" class="music-ctrl-btn" id="player-btn-lyric" title="歌词" aria-label="切换歌词显示">
      <svg viewBox="0 0 24 24"><path fill="currentColor" d="M20 2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14l4 4V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z"/></svg>
    </button>

    <button type="button" class="music-ctrl-btn" id="player-btn-toggle-view" title="播放列表" aria-label="切换播放列表">
      <svg viewBox="0 0 24 24"><path fill="currentColor" d="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z"/></svg>
    </button>
  </div>
</div>