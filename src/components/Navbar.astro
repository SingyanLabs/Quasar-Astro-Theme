---
// src/components/Navbar.astro
import { SITE_CONFIG, NAVBAR_CONFIG } from '../config';
import PerformanceGuard from './PerformanceGuard.astro';

import NavLogo from './navbar/NavLogo.astro';
import NavProgress from './navbar/NavProgress.astro';
import NavCenter from './navbar/NavCenter.astro';
import NavActions from './navbar/NavActions.astro';
import NavMobileMenu from './navbar/NavMobileMenu.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isAlbumPage = currentPath === '/albums';
---

<header 
  class="quasar-navbar" 
  id="quasar-navbar-element" 
  define:vars={{ themeColor: SITE_CONFIG.themeColor }}
  data-is-album={isAlbumPage ? "true" : "false"}
  data-restored={NAVBAR_CONFIG.perfRestored || "已恢复高性能模式"}
  data-manual-degraded={NAVBAR_CONFIG.perfManualDegraded || "已手动开启低性能模式"}
  data-light={NAVBAR_CONFIG.themeLight || "已切换至浅色模式"}
  data-dark={NAVBAR_CONFIG.themeDark || "已切换至深色模式"}
>
  <div class="liquid-glass-bg"></div>

  <div class="nav-container">
    <div class="nav-left" id="nav-left-container">
      <NavLogo />
      <NavProgress />
    </div>

    <NavCenter />
    <NavActions />
  </div>

  <!-- 移动端折叠抽屉组件 -->
  <NavMobileMenu />

  <div class="nav-progress-bar" id="nav-progress"></div>
  <PerformanceGuard />
</header>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" is:inline></script>

<script>
  import { initNavbarEngine } from '../assets/scripts/navbar-engine.js';
  document.addEventListener('astro:page-load', initNavbarEngine);
</script>

<style>
  :global(html) {
    scrollbar-gutter: stable;
  }

  .quasar-navbar { 
    position: fixed; top: 0; left: 0; width: 100vw; height: 72px; z-index: 100; font-family: 'Noto Sans SC', sans-serif; 
  }
 
  .liquid-glass-bg { 
    position: absolute; inset: 0; background: linear-gradient(180deg, rgba(255, 255, 255, 0.03) 0%, rgba(0, 0, 0, 0.15) 100%), rgba(10, 10, 16, 0.72); 
    backdrop-filter: blur(20px) saturate(160%); -webkit-backdrop-filter: blur(20px) saturate(160%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.08), 0 8px 32px rgba(0, 0, 0, 0.45);
    pointer-events: none; z-index: 1; transition: background 0.4s ease, border-color 0.4s ease, backdrop-filter 0.4s ease; 
  }

  .nav-container { 
    position: relative; z-index: 2; width: 100vw; max-width: 93.66vw; margin: 0 auto; height: 100%; display: flex; justify-content: space-between; align-items: center; padding: 0 40px; box-sizing: border-box;
  }
 
  .nav-left { display: flex; align-items: center; gap: 6px; flex-shrink: 1; max-width: 38vw; min-width: 0; }

  .nav-progress-bar { position: absolute; bottom: -1px; left: 0; height: 2px; width: 0%; background: var(--themeColor); opacity: 0; }

  /* 浅色模式与低性能模式底座 */
  :global(.light-mode) body { background-color: #f5f5f7 !important; color: #1d1d1f !important; }
  :global(.light-mode) .liquid-glass-bg { 
    background: rgba(255, 255, 255, 0.78); border-bottom: 1px solid rgba(0, 0, 0, 0.08); box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    backdrop-filter: blur(24px) saturate(190%); -webkit-backdrop-filter: blur(24px) saturate(190%);
  }

  :global(.perf-degraded) * { box-shadow: none !important; text-shadow: none !important; filter: none !important; will-change: auto !important; }
  :global(.perf-degraded) .liquid-glass-bg { backdrop-filter: none !important; -webkit-backdrop-filter: none !important; background: #0a0a0e !important; }
  :global(.perf-degraded.light-mode) .liquid-glass-bg { background: #ffffff !important; }

  /* ⚡ 移动端屏幕极简适配 */
  @media (max-width: 768px) {
    .nav-container { padding: 0 16px; }
    .nav-left { max-width: 60vw; }
  }
</style>